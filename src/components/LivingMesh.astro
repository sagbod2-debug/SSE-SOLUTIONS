---
---

<div class="living-mesh-wrap" aria-hidden="true">
  <canvas class="living-mesh-canvas" data-living-mesh></canvas>
  <svg class="living-mesh-grain" width="100%" height="100%" aria-hidden="true">
    <filter id="sse-mesh-noise">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.8"
        numOctaves="3"
        stitchTiles="stitch"
      />
    </filter>
    <rect width="100%" height="100%" filter="url(#sse-mesh-noise)" />
  </svg>
</div>

<style>
  .living-mesh-wrap {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    /* Repli CSS si WebGL est indisponible */
    background:
      radial-gradient(circle at 65% 35%, rgba(201, 162, 75, 0.18) 0%, transparent 52%),
      radial-gradient(circle at 25% 25%, #1D2A3A 0%, transparent 60%),
      radial-gradient(circle at 80% 80%, #3A2E1A 0%, transparent 58%),
      #1A1E21;
  }

  :global(html[data-theme="light"]) .living-mesh-wrap {
    background:
      radial-gradient(circle at 65% 35%, rgba(201, 162, 75, 0.14) 0%, transparent 52%),
      radial-gradient(circle at 25% 25%, #E9E4D8 0%, transparent 60%),
      radial-gradient(circle at 80% 80%, #EFE7D6 0%, transparent 58%),
      #F6F4EF;
  }

  .living-mesh-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .living-mesh-grain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.04;
    mix-blend-mode: overlay;
    pointer-events: none;
  }
</style>

