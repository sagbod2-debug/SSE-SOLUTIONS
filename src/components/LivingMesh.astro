---
interface Props {
  fixed?: boolean;
  tint?: 'care' | 'autonomie' | 'consulting' | 'events';
}

const { fixed = false, tint } = Astro.props;
---

<div
  class:list={['particle-field-wrap', { 'particle-field-wrap--fixed': fixed }]}
  data-particle-wrap
  data-default-tint={tint}
  aria-hidden="true"
>
  <canvas class="particle-field-canvas" data-living-mesh></canvas>
</div>

<style>
  .particle-field-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background-color: transparent;
    /* Repli CSS discret si WebGL est indisponible : trame de points gris à 30 % */
    background-image: radial-gradient(
      circle,
      rgba(11, 13, 18, 0.22) 1px,
      transparent 1px
    );
    background-size: 36px 36px;
  }

  :global(html[data-theme="dark"]) .particle-field-wrap {
    background-image: radial-gradient(
      circle,
      rgba(244, 246, 250, 0.22) 1px,
      transparent 1px
    );
  }

  .particle-field-wrap.has-webgl {
    background-image: none;
  }

  .particle-field-wrap--fixed {
    position: fixed;
    inset: 0;
    z-index: 0;
  }

  .particle-field-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
