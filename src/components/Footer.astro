---
import BrandLogo from './BrandLogo.astro';

const SHOW_LINKEDIN = import.meta.env.SHOW_LINKEDIN === 'true';
const LINKEDIN_URL = import.meta.env.PUBLIC_LINKEDIN_URL || '';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top grid-12">
      <div class="footer-brand">
        <a href="/" class="footer-logo-link" aria-label="SSE Solutions — Accueil">
          <BrandLogo brand="sse-solutions" size="sm" loading="lazy" alt="SSE Solutions" />
        </a>
        <p class="footer-title">SSE Solutions — Social, Security and Events</p>
        <p class="footer-subtitle">
          Une entreprise, trois activités : CC Care, CC Consulting, CC Events.
        </p>
      </div>

      <div class="footer-col">
        <p class="footer-heading">Activités</p>
        <ul class="footer-links">
          <li><a href="/cc-care" class="footer-link">CC Care</a></li>
          <li><a href="/cc-consulting" class="footer-link">CC Consulting</a></li>
          <li><a href="/cc-events" class="footer-link">CC Events</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <p class="footer-heading">Programme</p>
        <ul class="footer-links">
          <li>
            <a href="/cc-care/autonomie-inclusion" class="footer-link">
              Autonomie &amp; Inclusion
            </a>
          </li>
        </ul>
      </div>

      <div class="footer-col footer-col--contact">
        <p class="footer-heading">Contacts directs</p>
        <ul class="footer-links">
          <li>
            <a href="/contact" class="footer-link footer-link--highlight">
              Formulaire de contact →
            </a>
          </li>
          <li>
            <span class="footer-contact-item">
              <span class="footer-contact-tag">Général</span>
              <a href="mailto:contact@ssesolutions.fr" class="footer-link footer-email">
                contact@ssesolutions.fr
              </a>
            </span>
          </li>
          <li>
            <span class="footer-contact-item">
              <span class="footer-contact-tag">CC Care</span>
              <a href="mailto:cccare@ssesolutions.fr" class="footer-link footer-email">
                cccare@ssesolutions.fr
              </a>
            </span>
          </li>
          <li>
            <span class="footer-contact-item">
              <span class="footer-contact-tag">CC Consulting</span>
              <a href="mailto:ccconsulting@ssesolutions.fr" class="footer-link footer-email">
                ccconsulting@ssesolutions.fr
              </a>
            </span>
          </li>
          <li>
            <span class="footer-contact-item">
              <span class="footer-contact-tag">CC Events</span>
              <a href="mailto:ccevents@ssesolutions.fr" class="footer-link footer-email">
                ccevents@ssesolutions.fr
              </a>
            </span>
          </li>
        </ul>
      </div>

      <div class="footer-col">
        <p class="footer-heading">Légal</p>
        <ul class="footer-links">
          <li><a href="/mentions-legales" class="footer-link">Mentions légales</a></li>
          <li><a href="/confidentialite" class="footer-link">Confidentialité</a></li>
          <li><a href="/conditions-generales" class="footer-link">Conditions générales</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">© 2026 SSE Solutions · Boussy-Saint-Antoine, Essonne</p>
      {
        SHOW_LINKEDIN && LINKEDIN_URL && (
          <a
            href={LINKEDIN_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-link"
          >
            LinkedIn
          </a>
        )
      }
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--bg);
    border-top: 1px solid var(--line);
    padding-top: var(--space-64);
    padding-bottom: var(--space-40);
    color: var(--text-muted);
  }

  .footer-top {
    row-gap: var(--space-40);
    padding-bottom: var(--space-64);
    border-bottom: 1px solid var(--line);
  }

  .footer-brand {
    grid-column: 1 / -1;
  }

  @media (min-width: 1024px) {
    .footer-brand {
      grid-column: 1 / 5;
      padding-right: var(--space-24);
    }
  }

  .footer-logo-link {
    display: inline-flex;
    margin-bottom: var(--space-16);
  }

  .footer-title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    color: var(--text);
    margin-bottom: var(--space-16);
  }

  .footer-subtitle {
    font-size: var(--fs-small);
    color: var(--text-muted);
    max-width: 36ch;
  }

  .footer-col {
    grid-column: span 6;
  }

  @media (min-width: 640px) {
    .footer-col {
      grid-column: span 3;
    }
  }

  @media (min-width: 1024px) {
    .footer-col {
      grid-column: span 2;
    }
    .footer-col--contact {
      grid-column: span 3;
    }
  }

  .footer-heading {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text);
    margin-bottom: var(--space-16);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer-contact-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .footer-contact-tag {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    opacity: 0.8;
  }

  .footer-link--highlight {
    font-weight: 600;
    color: var(--text);
  }

  /* 2.3 Soulignement qui se dessine de gauche à droite (background-size 0 à 100 %, 300 ms) */
  .footer-link {
    display: inline;
    font-size: var(--fs-small);
    color: var(--text-muted);
    background: linear-gradient(var(--accent), var(--accent)) no-repeat 0 100%;
    background-size: 0% 1px;
    padding-bottom: 2px;
    transition: color 250ms var(--ease-out), background-size 300ms var(--ease-out);
  }

  .footer-link:hover,
  .footer-link:focus-visible {
    color: var(--accent);
    background-size: 100% 1px;
  }

  /* 3.4 Empêcher la coupure au milieu de l'adresse e-mail */
  .footer-email {
    overflow-wrap: normal;
    word-break: keep-all;
  }

  .footer-bottom {
    padding-top: var(--space-24);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
    font-size: var(--fs-small);
  }
</style>
