---
import BaseLayout from '../layouts/BaseLayout.astro';
import Picture from '../components/Picture.astro';
import BrandLogo from '../components/BrandLogo.astro';
import { SHOW_CONSULTING_FAQ, CONSULTING_FAQ_ITEMS, SHOW_REAL_PHOTOS } from '../config/flags';

const checklistItems = [
  'le registre de sécurité, à jour',
  'les rapports des vérifications périodiques de vos installations',
  'les contrats et attestations de maintenance de vos prestataires',
  'la preuve que les observations des rapports ont été levées',
  'les suites données aux prescriptions du dernier procès-verbal',
  "la trace des exercices d'évacuation et de l'information de votre personnel",
];

const activeFaqItems = CONSULTING_FAQ_ITEMS.filter((item) => item.answer.trim().length > 0);
const faqJsonLd =
  SHOW_CONSULTING_FAQ && activeFaqItems.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: activeFaqItems.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
          },
        })),
      }
    : undefined;
---

<BaseLayout
  title="Préparation commission de sécurité et conformité incendie ERP en Essonne · CC Consulting"
  description="CC Consulting accompagne les ERP, en priorité les établissements de soins, de l'audit de conformité incendie jusqu'à la levée des observations."
  theme="cc-consulting"
  jsonLd={faqJsonLd}
>
  <section class="section hero-consulting" transition:name="solution-card-consulting">
    <div class="container grid-12 hero-consulting-grid">
      <div class="hero-consulting-content">
        <div class="hero-activity-brand" data-hero-fade>
          <BrandLogo brand="cc-consulting" size="lg" loading="eager" alt="Logo officiel CC Consulting" />
          <div class="hero-activity-brand-meta">
            <p class="eyebrow">CC CONSULTING · SÉCURITÉ</p>
            <p class="hero-activity-brand-name">CC Consulting</p>
          </div>
        </div>
        <h1 class="hero-title" data-hero-fade>
          Préparez votre commission de sécurité sans mauvaise surprise.
        </h1>
        <p class="hero-verbs" aria-label="Conformer. Préparer. Sécuriser.">
          <span class="reveal-mask">
            <span class="reveal-line" data-hero-line>Conformer.</span>
          </span>
          <span class="reveal-mask">
            <span class="reveal-line" data-hero-line>Préparer.</span>
          </span>
          <span class="reveal-mask">
            <span class="reveal-line" data-hero-line>Sécuriser.</span>
          </span>
        </p>
        <p class="prose-measure hero-consulting-lead" data-hero-fade>
          CC Consulting accompagne les établissements recevant du public, en priorité les établissements de soins, de l'audit de conformité incendie jusqu'à la levée des observations.
        </p>

        <div class="btn-group hero-consulting-actions" data-hero-fade>
          <a href="/contact?sujet=cc-consulting" class="btn-primary" data-magnetic data-glow>
            <span>Faire le point sur mon établissement</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="hero-consulting-media" data-hero-fade>
        <div class="media-frame hero-consulting-frame">
          <Picture
            slug="10-cc-consulting-hero"
            alt="Façade géométrique en verre et acier d’un bâtiment contemporain photographié au crépuscule"
            sizes="(max-width: 960px) 92vw, 520px"
            loading="eager"
            fetchpriority="high"
            transitionName="activity-hero-consulting"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--spacious">
    <div class="container">
      <div class="grid-12 services-intro">
        <div class="services-intro-left">
          <p class="eyebrow" data-reveal>NOS SERVICES</p>
          <h2 class="section-title" data-reveal-title>
            <span class="reveal-mask">
              <span class="reveal-line">De l'audit à la commission.</span>
            </span>
          </h2>
        </div>
        <div class="services-intro-right" data-reveal>
          <div class="media-frame services-photo">
            <Picture
              slug="11-cc-consulting-services"
              alt="Plans d’architecture et documents techniques posés sur une table de travail pour un audit de conformité"
              sizes="(max-width: 960px) 92vw, 520px"
            />
          </div>
        </div>
      </div>

      <ol class="consulting-services-grid grid-12">
        <li class="consulting-card glass" data-glow data-reveal>
          <span class="num-index">01</span>
          <h3 class="card-title">Audit de conformité.</h3>
          <p>
            Un état des lieux précis de votre établissement face à la réglementation incendie.
          </p>
        </li>
        <li class="consulting-card glass" data-glow data-reveal>
          <span class="num-index">02</span>
          <h3 class="card-title">Mise en conformité.</h3>
          <p>
            Un plan d'actions clair et l'accompagnement jusqu'à la levée des observations.
          </p>
        </li>
        <li class="consulting-card glass" data-glow data-reveal>
          <span class="num-index">03</span>
          <h3 class="card-title">Commissions de sécurité.</h3>
          <p>
            La préparation des registres, des documents et des visites.
          </p>
        </li>
        <li class="consulting-card glass" data-glow data-reveal>
          <span class="num-index">04</span>
          <h3 class="card-title">Suivi des prestataires.</h3>
          <p>
            Le suivi des vérifications, des contrats et des rapports de vos prestataires.
          </p>
        </li>
        <li class="consulting-card glass" data-glow data-reveal>
          <span class="num-index">05</span>
          <h3 class="card-title">Assistance sécurité.</h3>
          <p>
            Un appui à la gestion de la sécurité de votre bâtiment au quotidien.
          </p>
        </li>
        <li class="consulting-card glass" data-glow data-reveal>
          <span class="num-index">06</span>
          <h3 class="card-title">Sensibilisation des équipes.</h3>
          <p>
            Des sessions pour que vos équipes connaissent les bons réflexes.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section--secondary section--spacious commission-checklist-section">
    <div class="container grid-12">
      <div class="checklist-header">
        <p class="eyebrow" data-reveal>POINTS DE CONTRÔLE</p>
        <h2 class="section-title" data-reveal-title>
          <span class="reveal-mask">
            <span class="reveal-line">Ce que la commission regarde en premier</span>
          </span>
        </h2>
      </div>

      <div class="checklist-content">
        <ul class="commission-checklist" data-checklist-animated role="list">
          {checklistItems.map((line) => (
            <li
              class="checklist-item glass is-checked"
              data-checklist-item
              data-glow
              aria-checked="true"
            >
              <span class="checklist-box" aria-hidden="true">
                <svg
                  class="checklist-icon"
                  data-check-icon
                  viewBox="0 0 20 20"
                  width="16"
                  height="16"
                  fill="none"
                >
                  <path
                    d="M4.5 10.5L8.2 14.2L15.5 6.5"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <span class="checklist-label">{line}</span>
            </li>
          ))}
        </ul>

        <p class="checklist-conclusion prose-measure" data-reveal>
          Nous vous aidons à tout remettre en ordre, prestataire par prestataire.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--spacious healthcare-safety-section">
    <div class="container grid-12">
      <div class="healthcare-safety-box glass" data-glow data-reveal>
        <p class="eyebrow">TYPE U · HÔPITAUX ET CLINIQUES</p>
        <h2 class="section-title" data-reveal-title>
          <span class="reveal-mask">
            <span class="reveal-line">Établissements de soins : une sécurité à part</span>
          </span>
        </h2>
        <p class="healthcare-safety-text prose-measure">
          Dans un hôpital, on n'évacue pas tout le monde dehors. La sécurité incendie repose d'abord sur le transfert horizontal : déplacer les patients vers une zone protégée du même étage. Cela suppose des portes et des compartiments qui jouent leur rôle, un désenfumage et une détection qui fonctionnent, et un personnel qui connaît les gestes, de jour comme de nuit.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--secondary section--spacious">
    <div class="container">
      <p class="eyebrow" data-reveal>POUR QUI</p>
      <ul class="consulting-audiences grid-12" data-reveal>
        <li class="consulting-audience-card glass" data-glow>
          <span class="num-index">01</span>
          <span class="consulting-audience-title">Établissements de soins (type U)</span>
        </li>
        <li class="consulting-audience-card glass" data-glow>
          <span class="num-index">02</span>
          <span class="consulting-audience-title">Autres établissements recevant du public</span>
        </li>
        <li class="consulting-audience-card glass" data-glow>
          <span class="num-index">03</span>
          <span class="consulting-audience-title">Entreprises</span>
        </li>
      </ul>
    </div>
  </section>

  {SHOW_CONSULTING_FAQ && (
    <section class="section section--spacious faq-section">
      <div class="container">
        <p class="eyebrow" data-reveal>QUESTIONS FRÉQUENTES</p>
        <h2 class="section-title" data-reveal-title>
          <span class="reveal-mask">
            <span class="reveal-line">Vos questions sur la commission de sécurité.</span>
          </span>
        </h2>

        <dl class="faq-list">
          {CONSULTING_FAQ_ITEMS.map((item) => (
            <div class="faq-item glass" data-glow data-reveal>
              <dt class="faq-question">{item.question}</dt>
              {item.answer && <dd class="faq-answer prose-measure">{item.answer}</dd>}
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  {SHOW_REAL_PHOTOS && (
    <section class="section real-photos-slot" data-real-photos-slot>
      <div class="container">
        <div class="real-photos-grid grid-12"></div>
      </div>
    </section>
  )}

  <section class="section section--spacious">
    <div class="container grid-12">
      <div class="consulting-contact-box glass">
        <h2 class="section-title" data-reveal-title>
          <span class="reveal-mask">
            <span class="reveal-line">Une commission de sécurité approche ?</span>
          </span>
        </h2>
        <div class="consulting-contact-actions" data-reveal>
          <a href="mailto:ccconsulting@ssesolutions.fr" class="consulting-email">
            ccconsulting@<wbr />ssesolutions.fr
          </a>
          <a href="/contact?sujet=cc-consulting" class="btn-primary" data-magnetic data-glow>
            <span>Faire le point sur mon établissement</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-consulting {
    padding-top: 8.5rem;
    padding-bottom: var(--space-64);
    border-top: 2px solid var(--activity-tint);
  }

  .hero-activity-brand {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-24);
    margin-bottom: var(--space-24);
  }

  .hero-activity-brand-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .hero-activity-brand-meta .eyebrow {
    margin-bottom: 0;
  }

  .hero-activity-brand-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .hero-consulting-grid {
    align-items: center;
    row-gap: var(--space-40);
  }

  .hero-consulting-content {
    grid-column: 1 / -1;
  }

  .hero-consulting-media {
    grid-column: 1 / -1;
  }

  @media (min-width: 960px) {
    .hero-consulting-content {
      grid-column: 1 / 8;
    }
    .hero-consulting-media {
      grid-column: 8 / 13;
    }
  }

  .hero-title {
    font-size: clamp(2.1rem, 1.35rem + 3vw, 3.6rem);
    max-width: 24ch;
  }

  .hero-verbs {
    margin-top: var(--space-24);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1rem + 1.5vw, 2.15rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--activity-tint);
    display: flex;
    flex-wrap: wrap;
    gap: 0.45em;
  }

  .hero-consulting-lead {
    margin-top: var(--space-24);
    font-size: clamp(1.125rem, 1.3vw, 1.3rem);
    color: var(--text);
  }

  .checklist-header {
    grid-column: 1 / -1;
    margin-bottom: var(--space-24);
  }

  .checklist-content {
    grid-column: 1 / -1;
  }

  @media (min-width: 960px) {
    .checklist-header {
      grid-column: 1 / 5;
      margin-bottom: 0;
    }
    .checklist-content {
      grid-column: 5 / 13;
    }
  }

  .commission-checklist {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .checklist-item {
    --pointer-glow: color-mix(in srgb, var(--tint-consulting) 16%, transparent);
    display: flex;
    align-items: center;
    gap: var(--space-16);
    padding: var(--space-24);
    border-radius: var(--radius-sharp);
    border-left: 2px solid var(--activity-tint);
  }

  .checklist-box {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-sharp);
    border: 1px solid var(--activity-tint);
    background-color: color-mix(in srgb, var(--activity-tint) 14%, transparent);
    color: var(--activity-tint);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .checklist-label {
    font-size: var(--fs-body);
    color: var(--text);
  }

  .checklist-conclusion {
    margin-top: var(--space-40);
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    color: var(--text);
  }

  @media (prefers-reduced-motion: reduce) {
    .checklist-icon {
      opacity: 1 !important;
      transform: scale(1) !important;
    }
  }

  .healthcare-safety-box {
    --pointer-glow: color-mix(in srgb, var(--tint-consulting) 16%, transparent);
    grid-column: 1 / -1;
    padding: var(--space-64) var(--space-40);
    border-top: 2px solid var(--activity-tint);
    border-radius: var(--radius-sharp);
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .healthcare-safety-text {
    font-size: clamp(1.0625rem, 1.25vw, 1.25rem);
    color: var(--text);
  }

  .faq-list {
    margin-top: var(--space-64);
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .faq-item {
    padding: var(--space-40);
    border-radius: var(--radius-sharp);
    border-left: 2px solid var(--activity-tint);
  }

  .faq-question {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    color: var(--text);
  }

  .faq-answer {
    margin-top: var(--space-16);
    color: var(--text-muted);
  }

  .hero-consulting-actions {
    margin-top: var(--space-40);
  }

  .hero-consulting-frame {
    aspect-ratio: 4 / 3;
    border-color: var(--activity-tint);
  }

  .services-intro {
    align-items: end;
    row-gap: var(--space-40);
    margin-bottom: var(--space-64);
  }

  .services-intro-left {
    grid-column: 1 / -1;
  }

  .services-intro-right {
    grid-column: 1 / -1;
  }

  @media (min-width: 960px) {
    .services-intro-left {
      grid-column: 1 / 7;
    }
    .services-intro-right {
      grid-column: 8 / 13;
    }
  }

  .services-photo {
    aspect-ratio: 16 / 10;
  }

  .consulting-services-grid {
    row-gap: var(--space-24);
  }

  .consulting-card {
    --pointer-glow: color-mix(in srgb, var(--tint-consulting) 16%, transparent);
    grid-column: 1 / -1;
    border-top: 2px solid var(--activity-tint);
    border-radius: var(--radius-sharp);
    padding: var(--space-40);
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    transition: border-color 250ms var(--ease-out);
  }

  @media (min-width: 640px) {
    .consulting-card {
      grid-column: span 6;
    }
  }

  @media (min-width: 1024px) {
    .consulting-card {
      grid-column: span 4;
    }
  }

  .consulting-card p {
    color: var(--text-muted);
  }

  .consulting-audiences {
    margin-top: var(--space-40);
    row-gap: var(--space-24);
  }

  .consulting-audience-card {
    --pointer-glow: color-mix(in srgb, var(--tint-consulting) 16%, transparent);
    grid-column: 1 / -1;
    border-left: 2px solid var(--activity-tint);
    padding: var(--space-40);
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  @media (min-width: 768px) {
    .consulting-audience-card {
      grid-column: span 4;
    }
  }

  .consulting-audience-title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    color: var(--text);
  }

  .consulting-contact-box {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: var(--space-40);
  }

  .consulting-contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-40);
  }

  .consulting-email {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.5vw, 2rem);
    color: var(--accent);
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.25rem;
    overflow-wrap: normal;
    transition: border-color 250ms var(--ease-out);
  }

  .consulting-email:hover {
    border-color: var(--accent);
  }
</style>
