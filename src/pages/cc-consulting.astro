---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import BrandLogo from '../components/BrandLogo.astro';
import logoLight from '../assets/logos/cc-consulting-sans-dore.png';
import logoDark from '../assets/logos/cc-consulting-sans-dore-mode-sombre.png';
import { SHOW_CONSULTING_FAQ, CONSULTING_FAQ_ITEMS, SHOW_REAL_PHOTOS } from '../config/flags';

const checklistItems = [
  'Le registre de sécurité, à jour.',
  'Les rapports des vérifications périodiques de vos installations.',
  'Les contrats et attestations de maintenance de vos prestataires.',
  'La preuve que les observations des rapports ont été levées.',
  'Les suites données aux prescriptions du dernier procès-verbal.',
  "La trace des exercices d'évacuation et de l'information de votre personnel.",
];

const services = [
  { title: 'Audit de conformité', sub: 'État des lieux incendie' },
  { title: 'Mise en conformité', sub: "Plan d'actions clair" },
  { title: 'Commissions de sécurité', sub: 'Registres, documents, visites' },
  { title: 'Suivi des prestataires', sub: 'Vérifications, contrats, rapports' },
  { title: 'Assistance sécurité', sub: 'Appui au quotidien' },
  { title: 'Sensibilisation des équipes', sub: 'Les bons réflexes' },
];

// ---------- Géométrie du schéma de nœuds (bureau et mobile) ----------
type Box = { x: number; y: number; w: number; h: number };
type Layout = { W: number; H: number; T: Box; Hub: Box; S: Box[]; F: Box; a: string; s: string[]; o: string[] };

const cy = (b: Box) => b.y + b.h / 2;
const curveH = (x1: number, y1: number, x2: number, y2: number) => {
  const dx = Math.max(40, (x2 - x1) * 0.5);
  return `M${x1} ${y1} C${x1 + dx} ${y1}, ${x2 - dx} ${y2}, ${x2} ${y2}`;
};

function desktopLayout(): Layout {
  const W = 1280, H = 660;
  const T = { x: 0, y: 290, w: 220, h: 84 };
  const Hub = { x: 280, y: 255, w: 210, h: 150 };
  const S = services.map((_, i) => ({ x: 570, y: 6 + i * 110, w: 370, h: 88 }));
  const F = { x: 1020, y: 282, w: 260, h: 96 };
  return {
    W, H, T, Hub, S, F,
    a: curveH(T.x + T.w, cy(T), Hub.x, cy(Hub)),
    s: S.map((b) => curveH(Hub.x + Hub.w, cy(Hub), b.x, cy(b))),
    o: S.map((b) => curveH(b.x + b.w, cy(b), F.x, cy(F))),
  };
}

function mobileLayout(): Layout {
  const W = 360, H = 1060;
  const T = { x: 50, y: 0, w: 260, h: 76 };
  const Hub = { x: 80, y: 140, w: 200, h: 130 };
  const S = services.map((_, i) => ({ x: 30, y: 340 + i * 94, w: 300, h: 76 }));
  const F = { x: 50, y: 950, w: 260, h: 90 };
  return {
    W, H, T, Hub, S, F,
    a: `M180 ${T.y + T.h} C180 ${T.y + T.h + 30}, 180 ${Hub.y - 30}, 180 ${Hub.y}`,
    s: S.map((b) => `M${Hub.x} ${cy(Hub)} C6 ${cy(Hub)}, 6 ${cy(b)}, ${b.x} ${cy(b)}`),
    o: S.map((b) => `M${b.x + b.w} ${cy(b)} C354 ${cy(b)}, 354 ${cy(F)}, ${F.x + F.w} ${cy(F)}`),
  };
}

// Calendrier d'apparition (identique à src/scripts/cc-consulting/page.js)
const T_LINK0 = [0.02, 0.08];
const T_HUB = [0.09, 0.04];
const tService = (i: number) => [0.12 + i * 0.1, 0.08];
const tServiceNode = (i: number) => [0.12 + i * 0.1 + 0.065, 0.04];
const tOut = (i: number) => [0.76 + i * 0.012, 0.1];
const T_FINAL = [0.88, 0.05];

const pos = (L: Layout, b: Box, t: number[]) =>
  `left:${(b.x / L.W) * 100}%;top:${(b.y / L.H) * 100}%;width:${(b.w / L.W) * 100}%;height:${(b.h / L.H) * 100}%;--s:${t[0]};--l:${t[1]};`;
const timing = (t: number[]) => `--s:${t[0]};--l:${t[1]};`;

const layouts = [
  { key: 'desktop', L: desktopLayout() },
  { key: 'mobile', L: mobileLayout() },
];
const dotOn = new Set(['a', 's0', 's2', 's4', 'o1', 'o4']);

const activeFaqItems = CONSULTING_FAQ_ITEMS.filter((item) => item.answer.trim().length > 0);
const faqJsonLd =
  SHOW_CONSULTING_FAQ && activeFaqItems.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: activeFaqItems.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
      }
    : undefined;
---

<BaseLayout
  title="Préparation commission de sécurité et conformité incendie ERP en Essonne · CC Consulting"
  description="CC Consulting accompagne les établissements recevant du public (ERP) et les entreprises, de l'audit de conformité incendie jusqu'à la levée des observations."
  theme="cc-consulting"
  jsonLd={faqJsonLd}
  livingMesh={false}
>
  <canvas class="cc-field" data-cc3d-field aria-hidden="true"></canvas>

  <section class="cc-hero" data-cc3d-hero data-cc3d-mode="logo" aria-labelledby="cc-hero-title">
    <canvas class="cc-hero__canvas" data-cc3d-canvas aria-hidden="true"></canvas>
    <div class="cc-hero__fallback" aria-hidden="true">
      <BrandLogo brand="cc-consulting" size="xl" loading="eager" alt="" />
    </div>
    <div class="cc-hero__fade" aria-hidden="true"></div>

    <div class="container cc-hero__inner">
      <div class="cc-hero__spacer" aria-hidden="true"></div>
      <div class="cc-hero__content">
        <nav class="activity-breadcrumb" aria-label="Fil d'Ariane" data-hero-fade>
          <a href="/" class="activity-breadcrumb-link">
            <span aria-hidden="true">←</span>
            <span>Retour à l'accueil</span>
          </a>
          <span class="activity-breadcrumb-sep" aria-hidden="true">/</span>
          <span class="activity-breadcrumb-current">CC Consulting</span>
        </nav>

        <h1 class="cc-hero__title" id="cc-hero-title" data-hero-fade>
          Préparez votre commission de sécurité sans mauvaise surprise.
        </h1>
        <p class="cc-hero__verbs" data-hero-fade>Conformer. Préparer. Sécuriser.</p>
        <p class="cc-hero__lead" data-hero-fade>
          CC Consulting accompagne les établissements recevant du public (ERP) et les entreprises, de l'audit de conformité incendie jusqu'à la levée des observations.
        </p>

        <div class="cc-actions" data-hero-fade>
          <a href="/contact?sujet=cc-consulting" class="cc-btn">Faire le point sur mon établissement</a>
          <a href="#services" class="cc-btn cc-btn--ghost">Voir nos services</a>
        </div>

        <dl class="cc-stats" data-hero-fade>
          <div><dt>types principaux</dt><dd>14</dd></div>
          <div><dt>types spéciaux</dt><dd>8</dd></div>
          <div><dt>catégories, jusqu'à la 5ème</dt><dd>1 à 5</dd></div>
        </dl>
        <p class="cc-types" data-hero-fade>
          J · L · M · N · O · P · R · S · T · U · V · W · X · Y<br />
          PA · CTS · SG · PS · GA · OA · EF · REF
        </p>
      </div>
    </div>
  </section>

  <section id="services" class="cc-flow" data-cc3d-flow aria-labelledby="cc-flow-title">
    <div class="cc-flow__stage">
      <div class="container cc-flow__inner">
        <div class="cc-flow__head">
          <h2 class="cc-section-title" id="cc-flow-title">De l'audit à la commission.</h2>
          <div class="cc-flow__step" aria-live="polite">
            <p class="cc-flow__step-num">Étape <span data-flow-step-num>00</span> sur 06</p>
            <p class="cc-flow__step-title" data-flow-step-title>Votre établissement</p>
            <p class="cc-flow__step-text" data-flow-step-text>Chaque service se relie à votre établissement, jusqu'à la commission.</p>
          </div>
        </div>

        {layouts.map(({ key, L }) => (
          <div class={`cc-graph cc-graph--${key}`} style={`aspect-ratio:${L.W} / ${L.H};`} aria-hidden={key === 'mobile' ? 'true' : undefined}>
            <svg class="cc-graph__wires" viewBox={`0 0 ${L.W} ${L.H}`} aria-hidden="true">
              <path class="cc-wire" d={L.a} pathLength="1" style={timing(T_LINK0)} />
              {L.s.map((d, i) => <path class="cc-wire" d={d} pathLength="1" style={timing(tService(i))} />)}
              {L.o.map((d, i) => <path class="cc-wire" d={d} pathLength="1" style={timing(tOut(i))} />)}
              {dotOn.has('a') && (
                <circle class="cc-pulse" r="3.5" style={timing(T_LINK0)}>
                  <animateMotion dur="2.2s" repeatCount="indefinite" path={L.a} />
                </circle>
              )}
              {L.s.map((d, i) => dotOn.has(`s${i}`) && (
                <circle class="cc-pulse" r="3.5" style={timing(tService(i))}>
                  <animateMotion dur={`${2.4 + i * 0.15}s`} repeatCount="indefinite" path={d} />
                </circle>
              ))}
              {L.o.map((d, i) => dotOn.has(`o${i}`) && (
                <circle class="cc-pulse" r="3.5" style={timing(tOut(i))}>
                  <animateMotion dur={`${2.7 + i * 0.1}s`} repeatCount="indefinite" path={d} />
                </circle>
              ))}
            </svg>

            <div class="cc-node" style={pos(L, L.T, [0, 0.03])}>
              <span class="cc-node__title">Votre établissement</span>
              <span class="cc-node__sub">ERP, ERT, tous types</span>
            </div>

            <div class="cc-node cc-node--hub" style={pos(L, L.Hub, T_HUB)}>
              <Image src={logoLight} alt="CC Consulting" widths={[240, 480]} sizes="200px" class="cc-hub-logo cc-hub-logo--light" loading="lazy" />
              <Image src={logoDark} alt="" widths={[240, 480]} sizes="200px" class="cc-hub-logo cc-hub-logo--dark" loading="lazy" />
            </div>

            {services.map((svc, i) => (
              <div class="cc-node cc-node--service" style={pos(L, L.S[i], tServiceNode(i))}>
                <span class="cc-node__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="cc-node__text">
                  <span class="cc-node__title">{svc.title}</span>
                  <span class="cc-node__sub">{svc.sub}</span>
                </span>
              </div>
            ))}

            <div class="cc-node cc-node--final" style={pos(L, L.F, T_FINAL)}>
              <span class="cc-node__title">Commission de sécurité</span>
              <span class="cc-node__sub">Dossier prêt, visite préparée</span>
            </div>
          </div>
        ))}

        <ol class="cc-sr-only">
          {services.map((svc) => <li>{svc.title} : {svc.sub}.</li>)}
        </ol>
      </div>
    </div>
  </section>

  <section class="cc-block" aria-labelledby="cc-check-title">
    <div class="container cc-block__inner">
      <h2 class="cc-section-title" id="cc-check-title" data-reveal>Ce que la commission regarde en premier</h2>
      <ul class="cc-check" role="list" data-reveal>
        {checklistItems.map((line) => <li>{line}</li>)}
      </ul>
      <p class="cc-check__conclusion" data-reveal>
        Nous vous aidons à tout remettre en ordre, prestataire par prestataire.
      </p>
    </div>
  </section>

  <section class="cc-block" aria-labelledby="cc-who-title">
    <div class="container cc-block__inner">
      <div class="cc-who__head" data-reveal>
        <h2 class="cc-section-title" id="cc-who-title">Tous les établissements recevant du public, sans exception.</h2>
        <p class="cc-who__lead">
          Les 14 types principaux, les types spéciaux et les petits établissements de 5ème catégorie, ainsi que les établissements recevant des travailleurs (ERT).
        </p>
      </div>
      <ul class="cc-who" role="list" data-reveal>
        <li class="cc-card">
          <h3 class="cc-card__title">Les 14 types principaux</h3>
          <p>J structures d'accueil pour personnes âgées ou handicapées, L salles, M commerces, N restaurants, O hôtels, P salles de danse et de jeux, R enseignement, S bibliothèques, T expositions, U soins, V cultes, W bureaux, X sport couvert, Y musées.</p>
        </li>
        <li class="cc-card">
          <h3 class="cc-card__title">Les types spéciaux</h3>
          <p>PA plein air, CTS chapiteaux, tentes et structures, SG structures gonflables, PS parcs de stationnement couverts, GA gares, OA hôtels-restaurants d'altitude, EF établissements flottants, REF refuges de montagne.</p>
        </li>
        <li class="cc-card">
          <h3 class="cc-card__title">De la 1ère à la 5ème catégorie</h3>
          <p>Des grands établissements aux petits ERP de 5ème catégorie. Pour les établissements de soins et médico-sociaux (types U et J), nous préparons le transfert horizontal vers une zone protégée du même niveau.</p>
        </li>
      </ul>
    </div>
  </section>

  {SHOW_CONSULTING_FAQ && (
    <section class="cc-block" aria-labelledby="cc-faq-title">
      <div class="container cc-block__inner">
        <h2 class="cc-section-title" id="cc-faq-title" data-reveal>Vos questions sur la commission de sécurité.</h2>
        <dl class="cc-faq">
          {CONSULTING_FAQ_ITEMS.map((item) => (
            <div class="cc-faq__item" data-reveal>
              <dt class="cc-faq__q">{item.question}</dt>
              {item.answer && <dd class="cc-faq__a">{item.answer}</dd>}
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  {SHOW_REAL_PHOTOS && (
    <section class="section real-photos-slot" data-real-photos-slot>
      <div class="container">
        <div class="real-photos-grid grid-12"></div>
      </div>
    </section>
  )}

  <section class="cc-block cc-block--cta" aria-labelledby="cc-cta-title">
    <div class="container">
      <div class="cc-cta" data-reveal>
        <div class="cc-cta__text">
          <h2 class="cc-section-title" id="cc-cta-title">Une commission de sécurité approche ?</h2>
          <a href="mailto:ccconsulting@ssesolutions.fr" class="cc-cta__mail">ccconsulting@ssesolutions.fr</a>
        </div>
        <a href="/contact?sujet=cc-consulting" class="cc-btn cc-btn--invert">Faire le point sur mon établissement</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initConsultingPage } from '../scripts/cc-consulting/page.js';

  let cleanup: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    cleanup = document.querySelector('[data-cc3d-hero]') ? initConsultingPage() : null;
  });
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>

<style>
  /* ---------- Champ de traits (fixe, derrière le contenu) ---------- */
  .cc-field {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    display: block;
  }

  /* ---------- Hero ---------- */
  .cc-hero {
    position: relative;
    min-height: max(46rem, 100vh);
    display: flex;
    align-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .cc-hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
  }

  .cc-hero.is-3d-ready .cc-hero__canvas {
    opacity: 1;
  }

  .cc-hero__fallback {
    display: none;
    position: absolute;
    right: 6%;
    top: 50%;
    transform: translateY(-50%);
    width: min(38%, 30rem);
  }

  .cc-hero.is-3d-fallback .cc-hero__fallback {
    display: block;
  }

  .cc-hero__fade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--bg) 95%, transparent) 0%, color-mix(in srgb, var(--bg) 80%, transparent) 32%, transparent 58%),
      linear-gradient(0deg, var(--bg) 0%, transparent 22%);
  }

  .cc-hero__inner {
    position: relative;
    z-index: 2;
    padding-top: 8rem;
    padding-bottom: 5rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .cc-hero__spacer {
    height: 20rem;
  }

  @media (min-width: 960px) {
    .cc-hero__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    }
    .cc-hero__spacer {
      display: none;
    }
  }

  .cc-hero__content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 38rem;
  }

  .activity-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .activity-breadcrumb-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 200ms var(--ease-out);
  }

  .activity-breadcrumb-link:hover {
    color: var(--text);
  }

  .activity-breadcrumb-sep {
    opacity: 0.5;
  }

  .activity-breadcrumb-current {
    color: var(--text);
    font-weight: 500;
  }

  .cc-hero__title {
    font-size: clamp(2.6rem, 1.4rem + 4.4vw, 5rem);
    line-height: 1.06;
    letter-spacing: -0.025em;
    font-weight: 450;
    max-width: 16ch;
  }

  .cc-hero__verbs {
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem);
    line-height: 1.25;
    color: var(--activity-tint);
    font-weight: 450;
  }

  .cc-hero__lead {
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--text-muted);
    max-width: 34rem;
  }

  .cc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .cc-btn {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 1.5rem;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    transition: background-color 200ms cubic-bezier(0.2, 0, 0, 1), color 200ms cubic-bezier(0.2, 0, 0, 1);
  }

  .cc-btn:hover {
    background: color-mix(in srgb, var(--text) 85%, var(--bg));
  }

  .cc-btn:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 3px;
  }

  .cc-btn--ghost {
    background: transparent;
    color: var(--text);
    border: 1px solid color-mix(in srgb, var(--text) 18%, transparent);
  }

  .cc-btn--ghost:hover {
    background: color-mix(in srgb, var(--text) 6%, transparent);
  }

  .cc-btn--invert {
    background: var(--bg);
    color: var(--text);
  }

  .cc-btn--invert:hover {
    background: color-mix(in srgb, var(--bg) 88%, var(--text));
  }

  .cc-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    margin-top: 1.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .cc-stats div {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .cc-stats dt {
    order: 2;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .cc-stats dd {
    order: 1;
    font-size: 2.5rem;
    line-height: 1;
    font-weight: 450;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .cc-types {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  /* ---------- Nœuds ---------- */
  .cc-flow {
    --p: 0;
    position: relative;
    z-index: 2;
    padding-block: 5rem 4rem;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 960px) {
    .cc-flow {
      height: 300vh;
      padding-block: 0;
    }
    .cc-flow__stage {
      position: sticky;
      top: 0;
      height: 100vh;
      min-height: 45rem;
      display: flex;
      align-items: center;
      padding-top: 5.5rem;
      padding-bottom: 1.5rem;
    }
  }

  .cc-flow__inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cc-flow__head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 960px) {
    .cc-flow__head {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      gap: 2rem;
    }
  }

  .cc-section-title {
    font-size: clamp(2rem, 1.3rem + 2.8vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    font-weight: 450;
  }

  .cc-flow__step {
    max-width: 28rem;
    min-height: 5.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cc-flow__step-num {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .cc-flow__step-title {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--text);
  }

  .cc-flow__step-text {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .cc-graph {
    position: relative;
    width: 100%;
    margin-inline: auto;
    container-type: inline-size;
  }

  .cc-graph--desktop {
    display: none;
  }

  @media (min-width: 960px) {
    .cc-graph--desktop {
      display: block;
      width: min(100%, calc((100vh - 15rem) * 1280 / 660));
    }
    .cc-graph--mobile {
      display: none;
    }
  }

  .cc-graph__wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
