---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLogo from '../components/BrandLogo.astro';
import { SHOW_EVENTS_PROOF, SHOW_REAL_PHOTOS } from '../config/flags';
import '../styles/activity-3d.css';

const offers = [
  { title: "Organisation d'événements", text: 'Conception, planning, prestataires et logistique de vos événements.' },
  { title: 'Gestion des équipes', text: 'Recrutement, briefing et encadrement des équipes sur le terrain.' },
  { title: 'Coordination le jour J', text: 'Un pilotage en temps réel pour que tout se déroule comme prévu.' },
];

const rules = [
  { title: 'Organisation', text: 'Chaque professionnel sait ce qu’il a à faire.' },
  { title: 'Déploiement', text: 'Une mise en place méthodique, des postes clairement définis et une régie active le jour J.' },
  { title: 'Satisfaction', text: 'Des invités enthousiastes et un événement mené à bien en toute sérénité.' },
];
---

<BaseLayout
  title="Organisation d'événements et coordination d'équipes en Essonne · CC Events"
  description="CC Events organise vos événements et coordonne les équipes événementielles, de la préparation au dernier invité parti."
  theme="cc-events"
  livingMesh={false}
>
  <canvas class="act-field" data-ev-field aria-hidden="true"></canvas>

  <div class="ev-hero-track" data-ev-track>
  <section class="act-hero ev-hero" data-ev-hero aria-labelledby="ev-hero-title">
    <canvas class="act-hero__canvas" data-ev-hero-canvas aria-hidden="true"></canvas>
    <div class="act-hero__fallback" aria-hidden="true">
      <BrandLogo brand="cc-events" size="xl" loading="eager" alt="" />
    </div>
    <div class="act-hero__fade" aria-hidden="true"></div>

    <div class="container act-hero__inner">
      <div class="act-hero__spacer" aria-hidden="true"></div>
      <div class="act-hero__content">
        <nav class="act-breadcrumb" aria-label="Fil d'Ariane" data-hero-fade>
          <a href="/"><span aria-hidden="true">←</span><span>Retour à l'accueil</span></a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">CC Events</span>
        </nav>
        <h1 class="act-title" id="ev-hero-title" data-hero-fade>Un événement réussi s’imagine, se coordonne…</h1>
        <p class="act-verbs" data-hero-fade>Imaginer. Coordonner. Réussir.</p>
        <p class="act-lead" data-hero-fade>
          CC Events organise vos événements et coordonne les équipes événementielles, de la préparation au dernier invité parti.
        </p>
        <div class="act-actions" data-hero-fade>
          <a href="/contact?sujet=cc-events" class="act-btn">Parler de mon événement</a>
          <a href="#offres" class="act-btn act-btn--ghost">Voir nos offres</a>
        </div>
      </div>
    </div>
  </section>
  </div>

  <section id="offres" class="ev-offers" data-ev-offers aria-labelledby="ev-offers-title">
    <div class="ev-offers__stage">
      <canvas class="ev-offers__canvas" data-ev-orbs-canvas aria-hidden="true"></canvas>
      <div class="container ev-offers__inner">
        <h2 class="act-section-title ev-offers__title" id="ev-offers-title">Ce que nous prenons en charge.</h2>
        <ol class="ev-offers__list" role="list">
          {offers.map((o, i) => (
            <li class="ev-offer" data-ev-offer tabindex="0">
              <span class="ev-offer__num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="ev-offer__title">{o.title}</h3>
              <p class="ev-offer__text">{o.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="act-block" aria-labelledby="ev-rules-title">
    <div class="container act-block__inner">
      <h2 class="act-section-title" id="ev-rules-title" data-reveal>Nos trois règles.</h2>
      <ol class="act-grid act-grid--3" role="list" data-reveal>
        {rules.map((r) => (
          <li class="act-card">
            <h3 class="act-card__title">{r.title}</h3>
            <p>{r.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="act-block" aria-labelledby="ev-who-title">
    <div class="container act-block__inner">
      <h2 class="act-section-title" id="ev-who-title" data-reveal>Pour qui.</h2>
      <ul class="act-list act-list--3" role="list" data-reveal>
        <li>Entreprises</li>
        <li>Institutions</li>
        <li>Associations</li>
      </ul>
    </div>
  </section>

  {SHOW_EVENTS_PROOF && (
    <section class="act-block" aria-labelledby="ev-proof-title">
      <div class="container act-block__inner">
        <h2 class="act-section-title" id="ev-proof-title" data-reveal>Ils nous ont fait confiance</h2>
        <div class="events-proof-gallery grid-12" data-reveal></div>
      </div>
    </section>
  )}

  {SHOW_REAL_PHOTOS && (
    <section class="section real-photos-slot" data-real-photos-slot>
      <div class="container">
        <div class="real-photos-grid grid-12"></div>
      </div>
    </section>
  )}

  <section class="act-block act-cta-wrap" aria-labelledby="ev-cta-title">
    <div class="container">
      <div class="act-cta" data-reveal>
        <div class="act-cta__text">
          <h2 class="act-section-title" id="ev-cta-title">Un événement en préparation ?</h2>
          <a href="mailto:ccevents@ssesolutions.fr" class="act-cta__mail">ccevents@ssesolutions.fr</a>
        </div>
        <a href="/contact?sujet=cc-events" class="act-btn act-btn--invert">Parler de mon événement</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initEventsPage } from '../scripts/events/page.js';

  let cleanup: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    cleanup = document.querySelector('[data-ev-hero]') ? initEventsPage() : null;
  });
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>

<style>
  /* Le hero reste à l'écran pendant que la scène se construit au défilement */
  @media (min-width: 960px) {
    .ev-hero-track {
      height: 210vh;
    }
    .ev-hero {
      position: sticky;
      top: 0;
      height: 100vh;
      min-height: 46rem;
    }
  }

  .ev-offers {
    position: relative;
    z-index: 2;
    border-bottom: 1px solid var(--line);
  }

  .ev-offers__canvas {
    position: relative;
    display: block;
    width: 100%;
    height: 22rem;
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
  }

  .ev-offers.is-3d-ready .ev-offers__canvas {
    opacity: 1;
  }

  .ev-offers__inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-bottom: 5rem;
  }

  .ev-offers__title {
    order: -1;
    padding-top: 5rem;
  }

  .ev-offers__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    list-style: none;
  }

  .ev-offer {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.75rem;
    border-radius: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    opacity: 0.55;
    transition: opacity 400ms var(--ease-out), border-color 400ms var(--ease-out), transform 500ms var(--ease-out);
    outline: none;
  }

  .ev-offer.is-active,
  .ev-offer:hover,
  .ev-offer:focus-visible {
    opacity: 1;
    border-color: color-mix(in srgb, var(--activity-tint) 45%, var(--line));
  }

  .ev-offer:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 3px;
  }

  .ev-offer__num {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--activity-tint);
  }

  .ev-offer__title {
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .ev-offer__text {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  /* Bureau : scène collante, sphères au-dessus des cartes alignées en trois colonnes */
  @media (min-width: 960px) {
    .ev-offers {
      height: 320vh;
    }
    .ev-offers__stage {
      position: sticky;
      top: 0;
      height: 100vh;
      min-height: 46rem;
      overflow: hidden;
    }
    .ev-offers__canvas {
      position: absolute;
      inset: 0;
      height: 100%;
    }
    .ev-offers__inner {
      position: relative;
      height: 100%;
      justify-content: space-between;
      padding-top: 6.5rem;
      padding-bottom: 3rem;
      pointer-events: none;
    }
    .ev-offers__title {
      padding-top: 0;
      max-width: 14ch;
    }
    .ev-offers__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
      pointer-events: auto;
    }
    .ev-offer {
      background: color-mix(in srgb, var(--surface) 88%, transparent);
      transform: translateY(12px);
    }
    .ev-offer.is-active {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ev-offer,
    .ev-offers__canvas {
      transition: none;
    }
  }
</style>
