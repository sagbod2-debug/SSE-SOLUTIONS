---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLogo from '../components/BrandLogo.astro';
import { SHOW_EVENTS_PROOF, SHOW_REAL_PHOTOS } from '../config/flags';
import '../styles/activity-3d.css';

const offers = [
  { title: "Organisation d'événements", text: 'Conception, planning, prestataires et logistique de vos événements.' },
  { title: 'Gestion des équipes', text: 'Recrutement, briefing et encadrement des équipes sur le terrain.' },
  { title: 'Coordination le jour J', text: 'Un pilotage en temps réel pour que tout se déroule comme prévu.' },
];

const rules = [
  { title: 'Organisation', text: 'Chaque professionnel sait ce qu’il a à faire.' },
  { title: 'Déploiement', text: 'Une mise en place méthodique, des postes clairement définis et une régie active le jour J.' },
  { title: 'Satisfaction', text: 'Des invités enthousiastes et un événement mené à bien en toute sérénité.' },
];
---

<BaseLayout
  title="Organisation d'événements et coordination d'équipes en Essonne · CC Events"
  description="CC Events organise vos événements et coordonne les équipes événementielles, de la préparation au dernier invité parti."
  theme="cc-events"
  livingMesh={false}
>
  <div class="film" data-film>
    <canvas class="film__canvas" data-film-canvas aria-hidden="true"></canvas>
    <div class="film__fallback" aria-hidden="true">
      <BrandLogo brand="cc-events" size="xl" loading="eager" alt="" />
    </div>

    <!-- Chapitre 1 : le montage (J-30 → Jour J) -->
    <section class="film__chapter film__chapter--hero" data-film-from="0" data-film-to="0.32" aria-labelledby="ev-hero-title">
      <div class="film__sticky">
        <p class="film__count" aria-hidden="true"><span data-film-count>J-30</span></p>
        <div class="container film__credits">
          <nav class="act-breadcrumb" aria-label="Fil d'Ariane">
            <a href="/"><span aria-hidden="true">←</span><span>Retour à l'accueil</span></a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">CC Events</span>
          </nav>
          <h1 class="film__title" id="ev-hero-title">Un événement réussi s’imagine, se coordonne…</h1>
          <p class="act-verbs">Imaginer. Coordonner. Réussir.</p>
          <p class="film__lead">
            CC Events organise vos événements et coordonne les équipes événementielles, de la préparation au dernier invité parti.
          </p>
          <div class="act-actions">
            <a href="/contact?sujet=cc-events" class="act-btn">Parler de mon événement</a>
            <a href="#offres" class="act-btn act-btn--ghost film__ghost">Voir nos offres</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Chapitre 2 : les offres, chacune vue sous un angle de la même salle -->
    <section id="offres" class="film__chapter" data-film-from="0.36" data-film-to="0.7" aria-labelledby="ev-offers-title">
      <div class="container film__inner">
        <h2 class="film__chapter-title act-section-title" id="ev-offers-title">Nos offres.</h2>
        <ol class="film__steps" role="list">
          {offers.map((o, i) => (
            <li class="film__panel" data-film-offer>
              <p class="film__panel-num">{String(i + 1).padStart(2, '0')} / 03</p>
              <h3 class="film__panel-title">{o.title}</h3>
              <p class="film__panel-text">{o.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Chapitre 3 : les règles, trois ambiances lumineuses -->
    <section class="film__chapter" data-film-from="0.74" data-film-to="1" aria-labelledby="ev-rules-title">
      <div class="container film__inner film__inner--right">
        <h2 class="film__chapter-title act-section-title" id="ev-rules-title">Nos trois règles.</h2>
        <ol class="film__steps" role="list">
          {rules.map((r, i) => (
            <li class="film__panel" data-film-rule>
              <p class="film__panel-num">{String(i + 1).padStart(2, '0')} / 03</p>
              <h3 class="film__panel-title">{r.title}</h3>
              <p class="film__panel-text">{r.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </div>

  <div class="after-film" data-film-end>
    <section class="act-block" aria-labelledby="ev-who-title">
      <div class="container act-block__inner">
        <h2 class="act-section-title" id="ev-who-title" data-reveal>Pour qui.</h2>
        <ul class="after-film__who" role="list" data-reveal>
          <li>Entreprises</li>
          <li>Institutions</li>
          <li>Associations</li>
        </ul>
      </div>
    </section>

    {SHOW_EVENTS_PROOF && (
      <section class="act-block" aria-labelledby="ev-proof-title">
        <div class="container act-block__inner">
          <h2 class="act-section-title" id="ev-proof-title" data-reveal>Ils nous ont fait confiance</h2>
          <div class="events-proof-gallery grid-12" data-reveal></div>
        </div>
      </section>
    )}

    {SHOW_REAL_PHOTOS && (
      <section class="section real-photos-slot" data-real-photos-slot>
        <div class="container">
          <div class="real-photos-grid grid-12"></div>
        </div>
      </section>
    )}

    <section class="act-block act-cta-wrap" aria-labelledby="ev-cta-title">
      <div class="container">
        <div class="act-cta" data-reveal>
          <div class="act-cta__text">
            <h2 class="act-section-title" id="ev-cta-title">Un événement en préparation ?</h2>
            <a href="mailto:ccevents@ssesolutions.fr" class="act-cta__mail">ccevents@ssesolutions.fr</a>
          </div>
          <a href="/contact?sujet=cc-events" class="act-btn act-btn--invert">Parler de mon événement</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { initEventsPage } from '../scripts/events/page.js';

  let cleanup: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    cleanup = document.querySelector('[data-film]') ? initEventsPage() : null;
  });
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>

<style>
  .film {
    position: relative;
  }

  .film__canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 0;
    opacity: 0;
    transition: opacity 1s var(--ease-out);
  }

  .film.is-3d-ready .film__canvas {
    opacity: 1;
  }

  .film.is-past .film__canvas {
    visibility: hidden;
  }

  .film__fallback {
    display: none;
    position: absolute;
    top: 8rem;
    right: 6%;
    width: min(36%, 28rem);
  }

  .film.is-3d-fallback .film__fallback {
    display: block;
  }

  .film__chapter {
    position: relative;
    z-index: 1;
  }

  /* Chapitre 1 : générique en bas de l'image */
  .film__chapter--hero {
    height: 320vh;
  }

  .film__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    min-height: 40rem;
    display: flex;
    align-items: flex-end;
    background: linear-gradient(0deg, color-mix(in srgb, var(--bg) 94%, transparent) 0%, color-mix(in srgb, var(--bg) 55%, transparent) 22%, transparent 40%);
  }

  .film__credits {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding-bottom: clamp(2.5rem, 6vh, 4.5rem);
  }

  .film__title {
    font-size: clamp(2.2rem, 1.2rem + 3vw, 3.9rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
    font-weight: 450;
    max-width: 18ch;
  }

  .film__lead {
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--text);
    max-width: 36rem;
  }

  .film__ghost {
    background: color-mix(in srgb, var(--bg) 70%, transparent);
  }

  .film__count {
    position: absolute;
    top: 6.5rem;
    right: var(--page-margin);
    font-family: var(--font-mono);
    font-size: clamp(2.5rem, 2rem + 3vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 1400px) {
    .film__count {
      right: calc((100vw - var(--container-max)) / 2);
    }
  }

  /* Chapitres 2 et 3 : panneaux qui défilent sur le côté pendant que la caméra bouge */
  .film__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-block: 18vh 40vh;
  }

  .film__inner--right {
    align-items: flex-end;
  }

  .film__chapter-title {
    padding: 0.35rem 0.9rem;
    border-radius: 14px;
    background: var(--bg);
    color: var(--text);
  }

  .film__steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 70vh;
    margin-top: 30vh;
    width: min(100%, 26rem);
  }

  .film__panel {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.75rem;
    border-radius: 18px;
    background: var(--bg);
    border: 1px solid var(--line);
    opacity: 0.6;
    transform: translateY(16px);
    transition: opacity 500ms var(--ease-out), transform 600ms var(--ease-out);
  }

  .film__panel.is-active {
    opacity: 1;
    transform: none;
  }

  .film__panel-num {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--activity-tint);
  }

  .film__panel-title {
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .film__panel-text {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  /* Après le film : blocs opaques */
  .after-film {
    position: relative;
    z-index: 2;
    background: var(--bg);
    border-top: 1px solid var(--line);
  }

  .after-film__who {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid var(--line);
  }

  .after-film__who li {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
    font-size: clamp(1.75rem, 1.2rem + 2vw, 3rem);
    font-weight: 450;
    letter-spacing: -0.02em;
  }

  @media (prefers-reduced-motion: reduce) {
    .film__panel {
      transition: none;
      transform: none;
    }
  }
</style>
