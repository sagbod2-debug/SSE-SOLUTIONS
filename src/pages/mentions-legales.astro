---
import BaseLayout from '../layouts/BaseLayout.astro';
import credits from '../data/credits.json';
---

<BaseLayout
  title="Mentions légales — SSE Solutions"
  description="SSE Solutions, entreprise individuelle de Carine Chali — 13 rue Marcel Pagnol, 91800 Boussy-Saint-Antoine — SIRET 999 125 131 00014."
>
  <section class="section legal-section">
    <div class="container grid-12">
      <div class="legal-content">
        <p class="eyebrow">INFORMATIONS LÉGALES</p>
        <h1 class="section-title">Mentions légales.</h1>

        <div class="legal-blocks">
          <article class="legal-block">
            <h2 class="card-title">Éditeur</h2>
            <p class="prose-measure">
              SSE Solutions, entreprise individuelle de Carine Chali — 13 rue Marcel Pagnol, 91800 Boussy-Saint-Antoine — SIRET 999 125 131 00014 — TVA non applicable, article 293 B du CGI.
            </p>
          </article>

          <article class="legal-block">
            <h2 class="card-title">Contact</h2>
            <p class="prose-measure">
              <a href="mailto:cccare@ssesolutions.fr" class="legal-link">
                cccare@<wbr />ssesolutions.fr
              </a>
            </p>
          </article>

          <article class="legal-block">
            <h2 class="card-title">Directrice de la publication</h2>
            <p class="prose-measure">Carine Chali.</p>
          </article>

          <article class="legal-block">
            <h2 class="card-title">Hébergeur</h2>
            <p class="prose-measure">
              Vercel Inc. — 440 N Barranca Ave #4133, Covina, CA 91723, États-Unis (vercel.com).
            </p>
          </article>

          <article class="legal-block">
            <h2 class="card-title">Propriété intellectuelle</h2>
            <p class="prose-measure">
              Textes, logos et visuels propres à SSE Solutions ; crédits photos listés en bas de page.
            </p>
          </article>

          <article class="legal-block">
            <h2 class="card-title">Données personnelles et conditions d'utilisation</h2>
            <p class="prose-measure">
              Voir la page <a href="/confidentialite" class="legal-link">Confidentialité</a> et les{' '}
              <a href="/conditions-generales" class="legal-link">conditions générales d'utilisation</a>.
            </p>
          </article>

          <article class="legal-block">
            <h2 class="card-title">Crédits photographiques</h2>
            <ul class="credits-list">
              {
                credits.map((item) => (
                  <li class="credit-item">
                    <span class="num-index">{String(item.id).padStart(2, '0')}</span>
                    <span class="credit-section">{item.section}</span>
                    <span class="credit-author">
                      Photographie par{' '}
                      <a
                        href={item.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="legal-link"
                      >
                        {item.photographer} ({item.source})
                      </a>
                    </span>
                  </li>
                ))
              }
            </ul>
          </article>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-section {
    padding-top: 8.5rem;
    padding-bottom: var(--space-104);
  }

  .legal-content {
    grid-column: 1 / -1;
  }

  @media (min-width: 960px) {
    .legal-content {
      grid-column: 1 / 10;
    }
  }

  .legal-blocks {
    margin-top: var(--space-64);
    display: flex;
    flex-direction: column;
    gap: var(--space-40);
  }

  .legal-block {
    padding-top: var(--space-24);
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .legal-link {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .credits-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: var(--space-8);
  }

  .credit-item {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.5rem 1rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-small);
  }

  @media (min-width: 768px) {
    .credit-item {
      grid-template-columns: 2.5rem 1fr 1fr;
    }
  }

  .credit-section {
    color: var(--text);
  }

  .credit-author {
    color: var(--text-muted);
    grid-column: 2 / -1;
  }

  @media (min-width: 768px) {
    .credit-author {
      grid-column: auto;
    }
  }
</style>
