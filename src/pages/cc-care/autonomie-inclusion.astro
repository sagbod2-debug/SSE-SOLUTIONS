---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogo from '../../components/BrandLogo.astro';
import { SHOW_PILOT_DETAILS, SHOW_REAL_PHOTOS } from '../../config/flags';
import '../../styles/activity-3d.css';

const modules35 = [
  { num: 1, title: 'Santé, hygiène et bien-être', cat: 'sante' },
  { num: 2, title: 'Vie sociale et citoyenneté', cat: 'citoyennete' },
  { num: 3, title: 'Autonomie et vie quotidienne', cat: 'quotidien' },
  { num: 4, title: 'Culture, loisirs et créativité', cat: 'culture' },
  { num: 5, title: 'Ateliers sociolinguistiques (ASL)', cat: 'competences' },
  { num: 6, title: 'Parentalité et vie familiale', cat: 'quotidien' },
  { num: 7, title: 'Gestion sociale, familiale et administrative', cat: 'quotidien' },
  { num: 8, title: 'Sécurité et prévention', cat: 'prevention' },
  { num: 9, title: 'Sorties pédagogiques et culturelles', cat: 'culture' },
  { num: 10, title: 'Cuisine du monde et interculturalité', cat: 'culture' },
  { num: 11, title: 'Remédiation et stimulation cognitive', cat: 'competences' },
  { num: 12, title: 'Autonomie numérique', cat: 'quotidien' },
  { num: 13, title: 'Insertion socioprofessionnelle', cat: 'competences' },
  { num: 14, title: 'Santé mentale et bien-être psychologique', cat: 'sante' },
  { num: 15, title: 'Communication verbale et non verbale', cat: 'citoyennete' },
  { num: 16, title: 'Écogestes et développement durable', cat: 'citoyennete' },
  { num: 17, title: 'Grands moments historiques', cat: 'culture' },
  { num: 18, title: 'Événements calendaires et prévention', cat: 'culture' },
  { num: 19, title: 'Mobilité, code de la route et accès au permis', cat: 'quotidien' },
  { num: 20, title: 'Prévention des écrans et réseaux sociaux', cat: 'prevention' },
  { num: 21, title: 'Mathématiques et raisonnement logique du quotidien', cat: 'competences' },
  { num: 22, title: 'Gestion des conflits et médiation', cat: 'citoyennete' },
  { num: 23, title: 'Droits, devoirs et citoyenneté', cat: 'citoyennete' },
  { num: 24, title: 'Relaxation et sophrologie', cat: 'sante' },
  { num: 25, title: 'Éducation morale et civique', cat: 'citoyennete' },
  { num: 26, title: 'Sensibilisation aux premiers secours', cat: 'prevention' },
  { num: 27, title: 'Prévention incendie et évacuation', cat: 'prevention' },
  { num: 28, title: 'Gestes et postures au travail', cat: 'prevention' },
  { num: 29, title: 'Prévention des accidents domestiques', cat: 'prevention' },
  { num: 30, title: 'Prévention des risques climatiques', cat: 'prevention' },
  { num: 31, title: 'Prévention des chutes et mobilité', cat: 'prevention' },
  { num: 32, title: 'Sécurité alimentaire et prévention des intoxications', cat: 'sante' },
  { num: 33, title: "Prévention des violences et demande d'aide", cat: 'prevention' },
  { num: 34, title: 'Santé sexuelle et consentement', cat: 'sante' },
  { num: 35, title: 'Logement et autonomie résidentielle', cat: 'quotidien' },
];

const seanceSteps = [
  'Découverte',
  'Exemple guidé',
  'Exercice',
  'Correction expliquée',
  'Nouvel essai',
  'Validation',
];
---
<BaseLayout
  title="Programme en ligne d’autonomie au quotidien, en FALC et français courant · Autonomie & Inclusion"
  description="Programme en ligne de 35 modules pour l’autonomie au quotidien des adultes accompagnés, en français courant et en version FALC."
  theme="autonomie-inclusion"
  livingMesh={false}
>
  <!-- Le quotidien en miniature : la ville, puis le parcours en quatre étapes -->
  <div class="at" data-town>
    <div class="at__stage">
      <canvas class="at__canvas" data-town-canvas aria-hidden="true"></canvas>
      <div class="at__labels" aria-hidden="true">
        <span class="at__label" data-town-label>Logement</span>
        <span class="at__label" data-town-label>Démarches</span>
        <span class="at__label" data-town-label>Santé</span>
        <span class="at__label" data-town-label>Mobilité</span>
        <span class="at__label" data-town-label>Budget</span>
      </div>
      <div class="at__fallback" aria-hidden="true">
        <BrandLogo brand="cc-care" size="xl" loading="eager" alt="" />
      </div>

      <div class="container at__hero">
        <nav class="act-breadcrumb" aria-label="Fil d'Ariane">
          <a href="/"><span aria-hidden="true">←</span><span>Retour à l'accueil</span></a>
          <span aria-hidden="true">/</span>
          <a href="/cc-care">CC Care</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Autonomie &amp; Inclusion</span>
        </nav>
        <h1 class="at__title">Autonomie &amp; Inclusion.</h1>
        <p class="at__lead">
          Un programme en ligne pour aider les adultes accompagnés par votre structure à gagner en autonomie dans la vie de tous les jours : démarches, santé, logement, numérique, budget, parentalité, mobilité.
        </p>
        <div class="act-actions">
          <a href="/contact?sujet=autonomie-inclusion" class="act-btn">Devenir structure partenaire</a>
        </div>
        <p class="at__note">Test gratuit en avant-première, début 2027.</p>
      </div>

      <div class="container at__steps-wrap">
        <h2 class="at__steps-title">Un parcours en quatre étapes.</h2>
        <ol class="at__steps" role="list">
          <li class="at__step" data-town-step><span class="at__step-num">01</span><h3>Découvrir.</h3><p>Les consignes, le vocabulaire, une première réussite.</p></li>
          <li class="at__step" data-town-step><span class="at__step-num">02</span><h3>S'entraîner.</h3><p>Répéter, voir des démonstrations, faire des exercices corrigés.</p></li>
          <li class="at__step" data-town-step><span class="at__step-num">03</span><h3>Appliquer.</h3><p>Des situations de la vie réelle et des prises de décision.</p></li>
          <li class="at__step" data-town-step><span class="at__step-num">04</span><h3>Devenir autonome.</h3><p>Agir seul, prévenir les risques, faire le bilan.</p></li>
        </ol>
      </div>
    </div>
  </div>

  <!-- Deux façons de lire : une carte qui se retourne -->
  <section class="act-block" aria-labelledby="au-read-title">
    <div class="container au-read">
      <div class="au-read__text">
        <h2 class="act-section-title" id="au-read-title" data-reveal>Deux façons de lire. Le même contenu.</h2>
        <div class="au-read__switch" role="group" aria-label="Choisir la version de lecture" data-flip-switch>
          <button type="button" class="au-read__opt is-on" aria-pressed="true" data-flip="falc">FALC</button>
          <button type="button" class="au-read__opt" aria-pressed="false" data-flip="courant">Français courant</button>
        </div>
        <p class="act-block__lead" data-reveal>
          Chaque personne choisit sa version. Les objectifs restent les mêmes, et restent pensés pour des adultes.
        </p>
      </div>
      <div class="au-card" data-flip-card>
        <div class="au-card__inner">
          <article class="au-card__face au-card__face--front" aria-hidden="false">
            <p class="au-card__tag">01</p>
            <h3 class="au-card__title">FALC</h3>
            <p class="au-card__text">Facile à lire et à comprendre. Des phrases courtes, des mots simples, une idée à la fois.</p>
          </article>
          <article class="au-card__face au-card__face--back" aria-hidden="true">
            <p class="au-card__tag">02</p>
            <h3 class="au-card__title">Français courant</h3>
            <p class="au-card__text">Pour les personnes à l'aise avec l'écrit, qui veulent aller plus loin.</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="act-block" aria-labelledby="au-beyond-title">
    <div class="container act-block__inner">
      <h2 class="act-section-title" id="au-beyond-title" data-reveal>Bien plus que le numérique</h2>
      <p class="au-beyond" data-reveal>
        Beaucoup d'outils d'inclusion se concentrent sur le numérique. Autonomie &amp; Inclusion couvre toute la vie quotidienne : démarches, santé, logement, budget, parentalité, mobilité, sécurité. Chaque atelier part d'une situation réelle et existe en deux versions de lecture.
      </p>
      <dl class="au-stats" data-reveal>
        <div><dt>modules</dt><dd data-count-to="35">35</dd></div>
        <div><dt>ateliers</dt><dd data-count-to="244">244</dd></div>
        <div><dt>fiches (chaque atelier en 2 versions)</dt><dd data-count-to="488">488</dd></div>
      </dl>
    </div>
  </section>

  <section class="act-block" aria-labelledby="au-seance-title">
    <div class="container act-block__inner">
      <h2 class="act-section-title" id="au-seance-title" data-reveal>Comment se passe une séance.</h2>
      <ol class="au-seance" aria-label="Déroulement d'une séance en 6 temps" data-reveal>
        {seanceSteps.map((step, idx) => (
          <li><span class="au-seance__num">{String(idx + 1).padStart(2, '0')}</span><span class="au-seance__name">{step}</span></li>
        ))}
      </ol>
      <p class="act-block__lead" data-reveal>
        En cas de difficulté, la personne reçoit un rappel et un nouvel exemple, puis elle réessaie. Votre équipe suit la progression de chacun.
      </p>
    </div>
  </section>

  <section class="act-block" id="modules-35" aria-labelledby="au-mod-title">
    <div class="container act-block__inner">
      <div class="au-mod__head">
        <h2 class="act-section-title" id="au-mod-title" data-reveal>Les 35 modules.</h2>
        <div class="au-mod__filters" role="group" aria-label="Filtrer les 35 modules par thème">
          <button type="button" class="au-chip is-active" data-filter="all" aria-pressed="true">Tous (35)</button>
          <button type="button" class="au-chip" data-filter="quotidien" aria-pressed="false">Vie quotidienne</button>
          <button type="button" class="au-chip" data-filter="sante" aria-pressed="false">Santé &amp; bien-être</button>
          <button type="button" class="au-chip" data-filter="citoyennete" aria-pressed="false">Citoyenneté</button>
          <button type="button" class="au-chip" data-filter="prevention" aria-pressed="false">Sécurité &amp; prévention</button>
          <button type="button" class="au-chip" data-filter="competences" aria-pressed="false">Apprentissages</button>
          <button type="button" class="au-chip" data-filter="culture" aria-pressed="false">Culture &amp; loisirs</button>
        </div>
      </div>
      <p class="act-sr-only" id="modules-live-status" aria-live="polite">35 modules affichés</p>
      <ol class="au-tiles" data-tiles>
        {modules35.map((m) => (
          <li class="au-tile" data-module-cat={m.cat}>
            <span class="au-tile__num">{String(m.num).padStart(2, '0')}</span>
            <span class="au-tile__title">{m.title}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {SHOW_PILOT_DETAILS && (
    <section class="act-block" aria-labelledby="au-pilot-title">
      <div class="container act-block__inner">
        <h2 class="act-section-title" id="au-pilot-title" data-reveal>Ce que comprend le test gratuit</h2>
      </div>
    </section>
  )}

  {SHOW_REAL_PHOTOS && (
    <section class="section real-photos-slot" data-real-photos-slot>
      <div class="container">
        <div class="real-photos-grid grid-12"></div>
      </div>
    </section>
  )}

  <section class="act-block act-cta-wrap" aria-labelledby="au-cta-title">
    <div class="container">
      <div class="act-cta" data-reveal>
        <div class="act-cta__text">
          <h2 class="act-section-title" id="au-cta-title">Testez-le avec nous.</h2>
          <p class="au-cta__text">
            Nous cherchons quelques structures de l'Essonne pour tester le programme gratuitement en avant-première, début 2027, avec un petit groupe de personnes accompagnées, et l'ajuster à leurs besoins. CCAS, centres sociaux, CHRS, missions locales, ESAT, associations : parlons-en.
          </p>
        </div>
        <a href="/contact?sujet=autonomie-inclusion" class="act-btn act-btn--invert">Devenir structure partenaire</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initAutonomiePage } from '../../scripts/autonomie/page.js';

  let cleanup: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    cleanup = document.querySelector('[data-town]') ? initAutonomiePage() : null;
  });
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>

<style>
  /* ---------- La ville et le parcours ---------- */
  .at {
    --ap: 0;
    position: relative;
    height: 460vh;
  }

  .at__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    min-height: 40rem;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .at__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1s var(--ease-out);
  }

  .at.is-3d-ready .at__canvas {
    opacity: 1;
  }

  .at__fallback {
    display: none;
    position: absolute;
    right: 8%;
    top: 30%;
    width: min(30%, 20rem);
  }

  .at.is-3d-fallback .at__fallback {
    display: block;
  }

  .at__labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* les étiquettes des lieux arrivent une fois le titre parti : rien ne se superpose au texte d'accueil */
    opacity: clamp(0, (var(--ap) - 0.1) / 0.06, 1);
  }

  .at.is-3d-fallback .at__labels {
    display: none;
  }

  .at__label {
    position: absolute;
    left: 0;
    top: 0;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--line);
    white-space: nowrap;
    transition: background-color 300ms var(--ease-out), color 300ms var(--ease-out);
  }

  .at__label.is-on {
    background: var(--activity-tint);
    color: var(--bg);
    border-color: transparent;
  }

  .at__hero {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    padding-top: 6.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    opacity: clamp(0, (0.14 - var(--ap)) / 0.08, 1);
    pointer-events: auto;
  }

  .at__title {
    font-size: clamp(2.6rem, 1.5rem + 4vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    font-weight: 450;
  }

  .at__lead {
    font-size: 1.0625rem;
    line-height: 1.55;
    max-width: 30rem;
    color: var(--text);
    background: color-mix(in srgb, var(--bg) 75%, transparent);
    border-radius: 12px;
  }

  .at__note {
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  .at__steps-wrap {
    position: absolute;
    left: 0;
    right: 0;
    top: 6rem;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1rem;
    opacity: clamp(0, (var(--ap) - 0.16) / 0.06, 1);
    pointer-events: none;
  }

  .at__steps-title {
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
    font-weight: 450;
    letter-spacing: -0.02em;
    padding: 0.35rem 0.9rem;
    border-radius: 14px;
    background: var(--bg);
  }

  .at__steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: min(100%, 22rem);
  }

  .at__step {
    padding: 0.9rem 1.1rem;
    border-radius: 14px;
    background: var(--bg);
    border: 1px solid var(--line);
    opacity: 0.45;
    transition: opacity 400ms var(--ease-out), border-color 400ms var(--ease-out);
  }

  .at__step.is-active {
    opacity: 1;
    border-color: var(--activity-tint);
  }

  .at__step h3 {
    font-size: 1.125rem;
    font-weight: 500;
  }

  .at__step p {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .at__step-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--activity-tint);
  }

  @media (max-width: 760px) {
    .at__steps-wrap {
      top: auto;
      bottom: 1.5rem;
    }
    .at__steps .at__step:not(.is-active) {
      display: none;
    }
  }

  /* ---------- Carte FALC / français courant ---------- */
  .au-read {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .au-read {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }

  .au-read__text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .au-read__switch {
    display: inline-flex;
    align-self: flex-start;
    padding: 0.3rem;
    border-radius: 999px;
    border: 1px solid var(--line);
  }

  .au-read__opt {
    min-height: 2.75rem;
    padding: 0 1.25rem;
    border-radius: 999px;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }

  .au-read__opt.is-on {
    background: var(--text);
    color: var(--bg);
  }

  .au-read__opt:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }

  .au-card {
    perspective: 1400px;
    min-height: 20rem;
  }

  .au-card__inner {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 20rem;
    transform-style: preserve-3d;
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .au-card.is-flipped .au-card__inner {
    transform: rotateY(180deg);
  }

  .au-card__face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: 24px;
    backface-visibility: hidden;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .au-card__face--front {
    background: var(--activity-tint);
    color: var(--bg);
    border-color: transparent;
  }

  .au-card__face--back {
    transform: rotateY(180deg);
  }

  .au-card__tag {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    opacity: 0.8;
  }

  .au-card__title {
    font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
    font-weight: 450;
    letter-spacing: -0.02em;
  }

  .au-card__face--front .au-card__title {
    color: var(--bg);
  }

  .au-card__text {
    font-size: 1.125rem;
    line-height: 1.5;
    max-width: 30rem;
  }

  /* ---------- Bien plus que le numérique ---------- */
  .au-beyond {
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    max-width: 52rem;
  }

  .au-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    border-top: 1px solid var(--line);
    padding-top: 2rem;
  }

  .au-stats div {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .au-stats dt {
    order: 2;
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  .au-stats dd {
    order: 1;
    font-size: clamp(2.5rem, 1.6rem + 3.5vw, 5rem);
    line-height: 1;
    font-weight: 450;
    letter-spacing: -0.03em;
    color: var(--activity-tint);
  }

  /* ---------- Séance ---------- */
  .au-seance {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (min-width: 900px) {
    .au-seance {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 0;
      border-top: 2px solid var(--activity-tint);
    }
    .au-seance li {
      padding-top: 1.25rem;
      position: relative;
    }
    .au-seance li::before {
      content: '';
      position: absolute;
      top: -0.45rem;
      left: 0;
      width: 0.8rem;
      height: 0.8rem;
      border-radius: 50%;
      background: var(--activity-tint);
    }
  }

  .au-seance li {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .au-seance__num {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .au-seance__name {
    font-size: 1.125rem;
    font-weight: 500;
  }

  /* ---------- 35 modules : tuiles qui se soulèvent ---------- */
  .au-mod__head {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .au-mod__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .au-chip {
    min-height: 2.75rem;
    padding: 0 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.9375rem;
    cursor: pointer;
    transition: background-color 200ms var(--ease-out), color 200ms var(--ease-out);
  }

  .au-chip.is-active {
    background: var(--text);
    color: var(--bg);
    border-color: transparent;
  }

  .au-chip:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }

  .au-tiles {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0.75rem;
    perspective: 1600px;
  }

  .au-tile {
