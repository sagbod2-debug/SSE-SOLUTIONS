---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Picture from '../../components/Picture.astro';
import BrandLogo from '../../components/BrandLogo.astro';
import { SHOW_CARE_FAQ, CARE_FAQ_ITEMS, SHOW_REAL_PHOTOS } from '../../config/flags';

const activeFaqItems = CARE_FAQ_ITEMS.filter((item) => item.answer.trim().length > 0);
const faqJsonLd =
  SHOW_CARE_FAQ && activeFaqItems.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: activeFaqItems.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
          },
        })),
      }
    : undefined;
---

<BaseLayout
  title="Accompagnement social pour structures sociales et entreprises en Essonne · CC Care"
  description="CC Care mène des missions d'accompagnement social, conduites par des travailleurs sociaux et intervenants sociaux, au sein des structures sociales et des entreprises."
  theme="cc-care"
  jsonLd={faqJsonLd}
>
  <section class="section hero-activity" transition:name="solution-card-care">
    <div class="container grid-12 hero-activity-grid">
      <div class="hero-activity-content">
        <nav class="activity-breadcrumb" aria-label="Fil d'Ariane" data-hero-fade>
          <a href="/" class="activity-breadcrumb-link">
            <span aria-hidden="true">←</span>
            <span>Retour à l'accueil</span>
          </a>
          <span class="activity-breadcrumb-sep" aria-hidden="true">/</span>
          <span class="activity-breadcrumb-current">CC Care</span>
        </nav>

        <div class="hero-activity-brand" data-hero-fade>
          <BrandLogo brand="cc-care" size="lg" loading="eager" alt="Logo officiel CC Care" />
          <div class="hero-activity-brand-meta">
            <p class="eyebrow">CC CARE · SOCIAL</p>
            <p class="hero-activity-brand-name">CC Care</p>
          </div>
        </div>
        <h1 class="hero-title" data-hero-fade>
          Une équipe d’intervenants sociaux pour vos résidents, vos usagers et vos salariés.
        </h1>
        <p class="hero-verbs" aria-label="Accompagner. Simplifier. Rendre autonome.">
          <span class="reveal-mask">
            <span class="reveal-line" data-hero-line>Accompagner.</span>
          </span>
          <span class="reveal-mask">
            <span class="reveal-line" data-hero-line>Simplifier.</span>
          </span>
          <span class="reveal-mask">
            <span class="reveal-line" data-hero-line>Rendre autonome.</span>
          </span>
        </p>
        <p class="prose-measure hero-activity-lead" data-hero-fade>
          CC Care mène des missions d'accompagnement social, conduites par des travailleurs sociaux et intervenants sociaux, au sein des structures sociales et des entreprises.
        </p>

        <div class="btn-group hero-activity-actions" data-hero-fade>
          <a href="/contact?sujet=cc-care" class="btn-primary" data-magnetic data-glow>
            <span>Exposer une situation</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
          <a href="/cc-care/autonomie-inclusion" class="btn-secondary glass" data-glow>
            <span>Le programme Autonomie &amp; Inclusion</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="hero-activity-aside" data-hero-fade>
        <div class="media-frame hero-activity-photo">
          <Picture
            slug="06-cc-care-hero"
            alt="Séance d'accompagnement et d'animation collective avec intervenante au sein d'une structure sociale"
            sizes="(max-width: 960px) 92vw, 520px"
            loading="eager"
            fetchpriority="high"
            transitionName="activity-hero-care"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--spacious situations-section">
    <div class="container">
      <p class="eyebrow" data-reveal>SITUATIONS CONCRÈTES</p>
      <h2 class="section-title" data-reveal-title>
        <span class="reveal-mask">
          <span class="reveal-line">Vous reconnaissez ces situations ?</span>
        </span>
      </h2>

      <ul class="situations-grid grid-12">
        <li class="situation-card glass" data-glow data-reveal>
          <span class="num-index">01</span>
          <p class="situation-text">
            Une rupture de logement ou de parcours qui fragilise l'insertion d'un usager.
          </p>
        </li>
        <li class="situation-card glass" data-glow data-reveal>
          <span class="num-index">02</span>
          <p class="situation-text">
            Une personne qui renonce à un droit parce que la démarche est trop complexe.
          </p>
        </li>
        <li class="situation-card glass" data-glow data-reveal>
          <span class="num-index">03</span>
          <p class="situation-text">
            Un salarié en difficulté personnelle que l'entreprise ne sait pas comment aider.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--secondary section--spacious">
    <div class="container">
      <div class="grid-12 missions-intro">
        <div class="missions-intro-left">
          <p class="eyebrow" data-reveal>NOS MISSIONS</p>
          <h2 class="section-title" data-reveal-title>
            <span class="reveal-mask">
              <span class="reveal-line">Tout ce qui touche au social.</span>
            </span>
          </h2>
          <p class="prose-measure missions-lead" data-reveal>
            Nous intervenons là où une situation sociale freine l'autonomie, l'accès aux droits ou la stabilité professionnelle.
          </p>
        </div>
        <div class="missions-intro-right" data-reveal>
          <div class="media-frame missions-photo">
            <Picture
              slug="07-cc-care-missions"
              alt="Accompagnement social personnalisé pour l'autonomie, l'accès aux droits et la solidarité"
              sizes="(max-width: 960px) 92vw, 520px"
            />
          </div>
        </div>
      </div>

      <ol class="missions-grid grid-12">
        <li class="mission-card glass" data-glow data-reveal>
          <span class="num-index">01</span>
          <h3 class="card-title">Accès aux droits et démarches.</h3>
          <p>
            Accompagner les personnes dans leurs démarches administratives et l'ouverture de leurs droits.
          </p>
        </li>
        <li class="mission-card glass" data-glow data-reveal>
          <span class="num-index">02</span>
          <h3 class="card-title">Autonomie et maintien du lien.</h3>
          <p>
            Coordonner les relais du quotidien et faciliter l'autonomie des personnes accompagnées.
          </p>
        </li>
        <li class="mission-card glass" data-glow data-reveal>
          <span class="num-index">03</span>
          <h3 class="card-title">Orientation.</h3>
          <p>
            Mettre les personnes en lien avec les bons services et les bons partenaires.
          </p>
        </li>
        <li class="mission-card glass" data-glow data-reveal>
          <span class="num-index">04</span>
          <h3 class="card-title">Appui aux équipes.</h3>
          <p>
            Apporter un regard social aux équipes des établissements et des entreprises.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section--spacious">
    <div class="container">
      <p class="eyebrow" data-reveal>POUR QUI</p>
      <h2 class="section-title" data-reveal-title>
        <span class="reveal-mask">
          <span class="reveal-line">Nos interlocuteurs.</span>
        </span>
      </h2>

      <ul class="audiences-grid grid-12" data-reveal>
        <li class="audience-item audience-item--half glass" data-glow>
          <span class="num-index">01</span>
          <span class="audience-label">Structures sociales</span>
          <p class="audience-sub">Foyers, résidences sociales, centres d'hébergement et structures d'accueil ou d'insertion.</p>
        </li>
        <li class="audience-item audience-item--half glass" data-glow>
          <span class="num-index">02</span>
          <span class="audience-label">Entreprises</span>
          <p class="audience-sub">Permanence sociale du travail, prévention de la précarité et appui direct à vos salariés.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--secondary section--spacious">
    <div class="container grid-12">
      <div class="care-programme-box">
        <p class="eyebrow" data-reveal>PROGRAMME EN LIGNE</p>
        <h2 class="section-title" data-reveal-title>
          <span class="reveal-mask">
            <span class="reveal-line">Autonomie &amp; Inclusion.</span>
          </span>
        </h2>
        <p class="prose-measure care-programme-text" data-reveal>
          Notre programme en ligne de 35 modules pour l'autonomie au quotidien, en français courant et en version FALC relue par des personnes concernées. Nous cherchons des structures partenaires pour le tester gratuitement début 2027.
        </p>
        <div class="btn-group" data-reveal>
          <a href="/cc-care/autonomie-inclusion" class="btn-primary" data-magnetic data-glow>
            <span>Découvrir le programme</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {SHOW_CARE_FAQ && (
    <section class="section section--spacious faq-section">
      <div class="container">
        <p class="eyebrow" data-reveal>QUESTIONS FRÉQUENTES</p>
        <h2 class="section-title" data-reveal-title>
          <span class="reveal-mask">
            <span class="reveal-line">Vos questions sur l'accompagnement social.</span>
          </span>
        </h2>

        <dl class="faq-list">
          {CARE_FAQ_ITEMS.map((item) => (
            <div class="faq-item glass" data-glow data-reveal>
              <dt class="faq-question">{item.question}</dt>
              {item.answer && <dd class="faq-answer prose-measure">{item.answer}</dd>}
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  {SHOW_REAL_PHOTOS && (
    <section class="section real-photos-slot" data-real-photos-slot>
      <div class="container">
        <div class="real-photos-grid grid-12"></div>
      </div>
    </section>
  )}

  <section class="section section--spacious">
    <div class="container grid-12">
      <div class="activity-contact-box glass">
        <h2 class="section-title" data-reveal-title>
          <span class="reveal-mask">
            <span class="reveal-line">Une situation à accompagner ?</span>
          </span>
        </h2>
        <div class="activity-contact-actions" data-reveal>
          <a href="mailto:cccare@ssesolutions.fr" class="contact-email-pill glass" data-glow>
            <svg class="email-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <span>cccare@ssesolutions.fr</span>
          </a>
          <a href="/contact?sujet=cc-care" class="btn-primary" data-magnetic data-glow>
            <span>Exposer une situation</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .activity-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-muted);
    margin-bottom: var(--space-20);
  }

  .activity-breadcrumb-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 200ms var(--ease-out);
  }

  .activity-breadcrumb-link:hover {
    color: var(--text);
  }

  .activity-breadcrumb-sep {
    opacity: 0.5;
  }

  .activity-breadcrumb-current {
    color: var(--activity-tint);
    font-weight: 600;
  }

  .hero-activity {
    padding-top: 8.5rem;
    padding-bottom: var(--space-64);
    border-top: 2px solid var(--activity-tint);
    position: relative;
  }

  .hero-activity-brand {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-24);
    margin-bottom: var(--space-24);
  }

  .hero-activity-brand-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .hero-activity-brand-meta .eyebrow {
    margin-bottom: 0;
  }

  .hero-activity-brand-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .hero-activity-grid {
    align-items: start;
    row-gap: var(--space-40);
  }

  .hero-activity-content {
    grid-column: 1 / -1;
  }

  .hero-activity-aside {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  @media (min-width: 960px) {
    .hero-activity-content {
      grid-column: 1 / 8;
    }
    .hero-activity-aside {
      grid-column: 8 / 13;
    }
  }

  .hero-title {
    font-size: clamp(2.1rem, 1.35rem + 3vw, 3.6rem);
    max-width: 24ch;
  }

  .hero-verbs {
    margin-top: var(--space-24);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1rem + 1.5vw, 2.15rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--activity-tint);
    display: flex;
    flex-wrap: wrap;
    gap: 0.45em;
  }

  .hero-activity-lead {
    margin-top: var(--space-24);
    font-size: clamp(1.125rem, 1.3vw, 1.3rem);
    color: var(--text);
  }

  .situations-grid {
    margin-top: var(--space-64);
    row-gap: var(--space-24);
  }

  .situation-card {
    --pointer-glow: color-mix(in srgb, var(--tint-care) 16%, transparent);
    grid-column: 1 / -1;
    border-top: 2px solid var(--activity-tint);
    border-radius: var(--radius-sharp);
    padding: var(--space-40);
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  @media (min-width: 768px) {
    .situation-card {
      grid-column: span 4;
    }
  }

  .situation-text {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    line-height: 1.38;
    color: var(--text);
  }

  .faq-list {
    margin-top: var(--space-64);
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .faq-item {
    padding: var(--space-40);
    border-radius: var(--radius-sharp);
    border-left: 2px solid var(--activity-tint);
  }

  .faq-question {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    color: var(--text);
  }

  .faq-answer {
    margin-top: var(--space-16);
    color: var(--text-muted);
  }

  .hero-activity-actions {
    margin-top: var(--space-40);
  }

  .logo-panel--care {
    align-self: flex-start;
    border-color: var(--activity-tint);
  }

  .hero-activity-photo {
    aspect-ratio: 16 / 10;
  }

  .missions-intro {
    align-items: center;
    row-gap: var(--space-40);
    margin-bottom: var(--space-64);
  }

  .missions-intro-left {
    grid-column: 1 / -1;
  }

  .missions-intro-right {
    grid-column: 1 / -1;
  }

  @media (min-width: 960px) {
    .missions-intro-left {
      grid-column: 1 / 7;
    }
    .missions-intro-right {
      grid-column: 8 / 13;
    }
  }

  .missions-lead {
    margin-top: var(--space-24);
    font-size: var(--fs-body);
  }

  .missions-photo {
    aspect-ratio: 16 / 10;
  }

  .missions-grid {
    row-gap: var(--space-24);
  }

  .mission-card {
    --pointer-glow: color-mix(in srgb, var(--tint-care) 16%, transparent);
    grid-column: 1 / -1;
    border-top: 2px solid var(--activity-tint);
    border-radius: var(--radius-sharp);
    padding: var(--space-40);
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  @media (min-width: 768px) {
    .mission-card {
      grid-column: span 6;
    }
  }

  .mission-card p {
    color: var(--text-muted);
  }

  .audiences-grid {
    margin-top: var(--space-64);
    row-gap: var(--space-24);
  }

  .audience-item {
    --pointer-glow: color-mix(in srgb, var(--tint-care) 16%, transparent);
    grid-column: 1 / -1;
    border-left: 2px solid var(--activity-tint);
    padding: var(--space-24) var(--space-40);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  @media (min-width: 640px) {
    .audience-item {
      grid-column: span 6;
    }
  }

  @media (min-width: 1024px) {
    .audience-item {
      grid-column: span 3;
    }
    .audience-item--half {
      grid-column: span 6;
    }
  }

  .audience-sub {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  .audience-label {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    color: var(--text);
  }

  .care-programme-box {
    grid-column: 1 / -1;
  }

  @media (min-width: 960px) {
    .care-programme-box {
      grid-column: 1 / 9;
    }
  }

  .care-programme-text {
    margin-top: var(--space-24);
    margin-bottom: var(--space-40);
    font-size: var(--fs-body);
    color: var(--text);
  }

  .activity-contact-box {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: var(--space-40);
  }

  .activity-contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-40);
  }

  .contact-email-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
    border: 1px solid var(--glass-border);
    background: var(--surface);
    transition: transform 200ms var(--ease-out), border-color 200ms var(--ease-out), color 200ms var(--ease-out);
  }

  .contact-email-pill:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    color: var(--accent);
  }

  .email-icon {
    flex-shrink: 0;
    color: var(--accent);
  }
</style>
