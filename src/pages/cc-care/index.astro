---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogo from '../../components/BrandLogo.astro';
import { SHOW_CARE_FAQ, CARE_FAQ_ITEMS, SHOW_REAL_PHOTOS } from '../../config/flags';
import '../../styles/activity-3d.css';

const situations = [
  "Une rupture de logement ou de parcours qui fragilise l'insertion d'un usager.",
  'Une personne qui renonce à un droit parce que la démarche est trop complexe.',
  "Un salarié en difficulté personnelle que l'entreprise ne sait pas comment aider.",
];

const missions = [
  { title: 'Accès aux droits et démarches', text: "Accompagner les personnes dans leurs démarches administratives et l'ouverture de leurs droits." },
  { title: 'Autonomie et maintien du lien', text: 'Coordonner les relais du quotidien et faciliter l’autonomie des personnes accompagnées.' },
  { title: 'Orientation', text: 'Mettre les personnes en lien avec les bons services et les bons partenaires.' },
  { title: 'Appui aux équipes', text: 'Apporter un regard social aux équipes des établissements et des entreprises.' },
];

const activeFaqItems = CARE_FAQ_ITEMS.filter((item) => item.answer.trim().length > 0);
const faqJsonLd =
  SHOW_CARE_FAQ && activeFaqItems.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: activeFaqItems.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
      }
    : undefined;
---

<BaseLayout
  title="Accompagnement social pour structures sociales et entreprises en Essonne · CC Care"
  description="CC Care mène des missions d'accompagnement social, conduites par des travailleurs sociaux et intervenants sociaux, au sein des structures sociales et des entreprises."
  theme="cc-care"
  jsonLd={faqJsonLd}
  livingMesh={false}
>
  <canvas class="act-field" data-care-field aria-hidden="true"></canvas>

  <div class="care-hero-track" data-care-track>
    <section class="act-hero care-hero" data-care-hero aria-labelledby="care-hero-title">
      <canvas class="act-hero__canvas" data-care-hero-canvas aria-hidden="true"></canvas>
      <div class="act-hero__fallback" aria-hidden="true">
        <BrandLogo brand="cc-care" size="xl" loading="eager" alt="" />
      </div>
      <div class="act-hero__fade" aria-hidden="true"></div>

      <div class="container act-hero__inner">
        <div class="act-hero__spacer" aria-hidden="true"></div>
        <div class="act-hero__content">
          <nav class="act-breadcrumb" aria-label="Fil d'Ariane" data-hero-fade>
            <a href="/"><span aria-hidden="true">←</span><span>Retour à l'accueil</span></a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">CC Care</span>
          </nav>
          <h1 class="act-title act-title--long" id="care-hero-title" data-hero-fade>Une équipe d’intervenants sociaux pour vos résidents, vos usagers et vos salariés.</h1>
          <p class="act-verbs" data-hero-fade>Accompagner. Simplifier. Rendre autonome.</p>
          <p class="act-lead" data-hero-fade>
            CC Care mène des missions d'accompagnement social, conduites par des travailleurs sociaux et intervenants sociaux, au sein des structures sociales et des entreprises.
          </p>
          <div class="act-actions" data-hero-fade>
            <a href="/contact?sujet=cc-care" class="act-btn">Exposer une situation</a>
            <a href="/cc-care/autonomie-inclusion" class="act-btn act-btn--ghost">Le programme Autonomie &amp; Inclusion</a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <section class="act-block" aria-labelledby="care-sit-title">
    <div class="container act-block__inner">
      <h2 class="act-section-title" id="care-sit-title" data-reveal>Vous reconnaissez ces situations ?</h2>
      <ul class="act-list act-list--3" role="list" data-reveal>
        {situations.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </section>

  <section class="care-missions" data-care-missions aria-labelledby="care-mis-title">
    <div class="care-missions__stage">
      <div class="container care-missions__inner">
        <div class="care-missions__text">
          <h2 class="act-section-title" id="care-mis-title">Tout ce qui touche au social.</h2>
          <p class="act-block__lead">
            Nous intervenons là où une situation sociale freine l'autonomie, l'accès aux droits ou la stabilité professionnelle.
          </p>
          <ol class="care-missions__list" role="list">
            {missions.map((m, i) => (
              <li class="care-mission" data-care-mission>
                <span class="care-mission__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="care-mission__body">
                  <h3 class="care-mission__title">{m.title}</h3>
                  <p class="care-mission__text">{m.text}</p>
                </span>
              </li>
            ))}
          </ol>
        </div>
        <canvas class="care-missions__canvas" data-care-cells-canvas aria-hidden="true"></canvas>
      </div>
    </div>
  </section>

  <section class="act-block" aria-labelledby="care-who-title">
    <div class="container act-block__inner">
      <h2 class="act-section-title" id="care-who-title" data-reveal>Nos interlocuteurs.</h2>
      <ul class="act-grid act-grid--2" role="list" data-reveal>
        <li class="act-card">
          <h3 class="act-card__title">Structures sociales</h3>
          <p>Foyers, résidences sociales, centres d'hébergement et structures d'accueil ou d'insertion.</p>
        </li>
        <li class="act-card">
          <h3 class="act-card__title">Entreprises</h3>
          <p>Permanence sociale du travail, prévention de la précarité et appui direct à vos salariés.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="act-block" aria-labelledby="care-prog-title">
    <div class="container">
      <div class="care-program" data-reveal>
        <div class="care-program__text">
          <h2 class="act-section-title" id="care-prog-title">Autonomie &amp; Inclusion.</h2>
          <p class="act-block__lead">
            Notre programme en ligne de 35 modules pour l'autonomie au quotidien, en français courant et en version FALC relue par des personnes concernées. Nous cherchons des structures partenaires pour le tester gratuitement début 2027.
          </p>
        </div>
        <a href="/cc-care/autonomie-inclusion" class="act-btn">Découvrir le programme</a>
      </div>
    </div>
  </section>

  {SHOW_CARE_FAQ && (
    <section class="act-block" aria-labelledby="care-faq-title">
      <div class="container act-block__inner">
        <h2 class="act-section-title" id="care-faq-title" data-reveal>Vos questions sur l'accompagnement social.</h2>
        <dl class="act-list">
          {CARE_FAQ_ITEMS.map((item) => (
            <div data-reveal>
              <dt class="act-card__title">{item.question}</dt>
              {item.answer && <dd class="act-block__lead">{item.answer}</dd>}
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  {SHOW_REAL_PHOTOS && (
    <section class="section real-photos-slot" data-real-photos-slot>
      <div class="container">
        <div class="real-photos-grid grid-12"></div>
      </div>
    </section>
  )}

  <section class="act-block act-cta-wrap" aria-labelledby="care-cta-title">
    <div class="container">
      <div class="act-cta" data-reveal>
        <div class="act-cta__text">
          <h2 class="act-section-title" id="care-cta-title">Une situation à accompagner ?</h2>
          <a href="mailto:cccare@ssesolutions.fr" class="act-cta__mail">cccare@ssesolutions.fr</a>
        </div>
        <a href="/contact?sujet=cc-care" class="act-btn act-btn--invert">Exposer une situation</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initCarePage } from '../../scripts/care/page.js';

  let cleanup: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    cleanup = document.querySelector('[data-care-hero]') ? initCarePage() : null;
  });
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>

<style>
  @media (min-width: 960px) {
    .care-hero-track {
      height: 200vh;
    }
    .care-hero {
      position: sticky;
      top: 0;
      height: 100vh;
      min-height: 46rem;
    }
  }

  .care-missions {
    position: relative;
    z-index: 2;
    border-block: 1px solid var(--line);
    background: var(--bg);
  }

  .care-missions__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    padding-block: 5rem;
  }

  .care-missions__text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .care-missions__canvas {
    width: 100%;
    height: 22rem;
    display: block;
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
    order: -1;
  }

  .care-missions.is-3d-ready .care-missions__canvas {
    opacity: 1;
  }

  .care-missions__list {
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .care-mission {
    display: flex;
    gap: 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
    opacity: 0.5;
    transition: opacity 400ms var(--ease-out);
  }

  .care-mission.is-active {
    opacity: 1;
  }

  .care-mission__num {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--activity-tint);
    padding-top: 0.3rem;
  }

  .care-mission__body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .care-mission__title {
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .care-mission__text {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  @media (min-width: 960px) {
    .care-missions {
      height: 280vh;
    }
    .care-missions__stage {
      position: sticky;
      top: 0;
      height: 100vh;
      min-height: 46rem;
      display: flex;
      align-items: center;
    }
    .care-missions__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 3rem;
      padding-block: 6rem 2rem;
      width: 100%;
    }
    .care-missions__canvas {
      order: 0;
      height: min(70vh, 36rem);
    }
  }

  .care-program {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: 28px;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .care-program__text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 46rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .care-mission,
    .care-missions__canvas {
      transition: none;
    }
  }
</style>
