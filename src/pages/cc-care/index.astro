---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandLogo from '../../components/BrandLogo.astro';
import { SHOW_CARE_FAQ, CARE_FAQ_ITEMS, SHOW_REAL_PHOTOS } from '../../config/flags';
import '../../styles/activity-3d.css';

const situations = [
  "Une rupture de logement ou de parcours qui fragilise l'insertion d'un usager.",
  'Une personne qui renonce à un droit parce que la démarche est trop complexe.',
  "Un salarié en difficulté personnelle que l'entreprise ne sait pas comment aider.",
];

const missions = [
  { title: 'Accès aux droits et démarches.', text: "Accompagner les personnes dans leurs démarches administratives et l'ouverture de leurs droits." },
  { title: 'Autonomie et maintien du lien.', text: 'Coordonner les relais du quotidien et faciliter l’autonomie des personnes accompagnées.' },
  { title: 'Orientation.', text: 'Mettre les personnes en lien avec les bons services et les bons partenaires.' },
  { title: 'Appui aux équipes.', text: 'Apporter un regard social aux équipes des établissements et des entreprises.' },
];

const activeFaqItems = CARE_FAQ_ITEMS.filter((item) => item.answer.trim().length > 0);
const faqJsonLd =
  SHOW_CARE_FAQ && activeFaqItems.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: activeFaqItems.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
      }
    : undefined;
---

<BaseLayout
  title="Accompagnement social pour structures sociales et entreprises en Essonne · CC Care"
  description="CC Care mène des missions d'accompagnement social, conduites par des travailleurs sociaux et intervenants sociaux, au sein des structures sociales et des entreprises."
  theme="cc-care"
  jsonLd={faqJsonLd}
  livingMesh={false}
>
  <!-- Ensemble : les formes éparses se rassemblent autour du logo -->
  <div class="ch" data-care-hero>
    <div class="ch__stage">
      <canvas class="ch__canvas" data-care-hero-canvas aria-hidden="true"></canvas>
      <div class="ch__fallback" aria-hidden="true">
        <BrandLogo brand="cc-care" size="xl" loading="eager" alt="" />
      </div>
      <div class="container ch__top">
        <nav class="act-breadcrumb ch__crumb" aria-label="Fil d'Ariane">
          <a href="/"><span aria-hidden="true">←</span><span>Retour à l'accueil</span></a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">CC Care</span>
        </nav>
        <h1 class="ch__title">Une équipe d’intervenants sociaux pour vos résidents, vos usagers et vos salariés.</h1>
        <p class="act-verbs">Accompagner. Simplifier. Rendre autonome.</p>
      </div>
      <div class="container ch__bottom">
        <p class="ch__lead">
          CC Care mène des missions d'accompagnement social, conduites par des travailleurs sociaux et intervenants sociaux, au sein des structures sociales et des entreprises.
        </p>
        <div class="act-actions ch__actions">
          <a href="/contact?sujet=cc-care" class="act-btn">Exposer une situation</a>
          <a href="/cc-care/autonomie-inclusion" class="act-btn act-btn--ghost">Le programme Autonomie &amp; Inclusion</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Une personne seule, puis chaque mission vient l'entourer -->
  <section class="cs" data-care-shelter aria-labelledby="cs-sit-title">
    <div class="container cs__grid">
      <div class="cs__visual">
        <canvas class="cs__canvas" data-care-shelter-canvas aria-hidden="true"></canvas>
      </div>
      <div class="cs__text">
        <div class="cs__group">
          <h2 class="act-section-title" id="cs-sit-title">Vous reconnaissez ces situations ?</h2>
          <ul class="cs__list" role="list">
            {situations.map((s) => <li class="cs__item cs__item--situation" data-care-step>{s}</li>)}
          </ul>
        </div>
        <div class="cs__group">
          <h2 class="act-section-title">Tout ce qui touche au social.</h2>
          <p class="act-block__lead">
            Nous intervenons là où une situation sociale freine l'autonomie, l'accès aux droits ou la stabilité professionnelle.
          </p>
          <ol class="cs__list" role="list">
            {missions.map((m) => (
              <li class="cs__item" data-care-step data-care-mission>
                <h3 class="cs__title">{m.title}</h3>
                <p class="cs__desc">{m.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="act-block" aria-labelledby="care-who-title">
    <div class="container act-block__inner">
      <h2 class="act-section-title" id="care-who-title" data-reveal>Nos interlocuteurs.</h2>
      <ul class="cw" role="list" data-reveal>
        <li>
          <h3 class="cw__name">Structures sociales</h3>
          <p class="cw__desc">Foyers, résidences sociales, centres d'hébergement et structures d'accueil ou d'insertion.</p>
        </li>
        <li>
          <h3 class="cw__name">Entreprises</h3>
          <p class="cw__desc">Permanence sociale du travail, prévention de la précarité et appui direct à vos salariés.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="act-block" aria-labelledby="care-prog-title">
    <div class="container">
      <div class="cp" data-reveal>
        <div class="cp__text">
          <h2 class="act-section-title" id="care-prog-title">Autonomie &amp; Inclusion.</h2>
          <p class="act-block__lead">
            Notre programme en ligne de 35 modules pour l'autonomie au quotidien, en français courant et en version FALC relue par des personnes concernées. Nous cherchons des structures partenaires pour le tester gratuitement début 2027.
          </p>
        </div>
        <a href="/cc-care/autonomie-inclusion" class="act-btn">Découvrir le programme</a>
      </div>
    </div>
  </section>

  {SHOW_CARE_FAQ && (
    <section class="act-block" aria-labelledby="care-faq-title">
      <div class="container act-block__inner">
        <h2 class="act-section-title" id="care-faq-title" data-reveal>Vos questions sur l'accompagnement social.</h2>
        <dl class="act-list">
          {CARE_FAQ_ITEMS.map((item) => (
            <div data-reveal>
              <dt class="act-card__title">{item.question}</dt>
              {item.answer && <dd class="act-block__lead">{item.answer}</dd>}
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  {SHOW_REAL_PHOTOS && (
    <section class="section real-photos-slot" data-real-photos-slot>
      <div class="container">
        <div class="real-photos-grid grid-12"></div>
      </div>
    </section>
  )}

  <section class="act-block act-cta-wrap" aria-labelledby="care-cta-title">
    <div class="container">
      <div class="act-cta" data-reveal>
        <div class="act-cta__text">
          <h2 class="act-section-title" id="care-cta-title">Une situation à accompagner ?</h2>
          <a href="mailto:cccare@ssesolutions.fr" class="act-cta__mail">cccare@ssesolutions.fr</a>
        </div>
        <a href="/contact?sujet=cc-care" class="act-btn act-btn--invert">Exposer une situation</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initCarePage } from '../../scripts/care/page.js';

  let cleanup: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    cleanup = document.querySelector('[data-care-hero]') ? initCarePage() : null;
  });
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>

<style>
  /* ---------- Hero centré ---------- */
  .ch {
    position: relative;
    height: 240vh;
  }

  .ch__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    min-height: 42rem;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .ch__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1s var(--ease-out);
  }

  .ch.is-3d-ready .ch__canvas {
    opacity: 1;
  }

  .ch__fallback {
    display: none;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -40%);
    width: min(40%, 18rem);
  }

  .ch.is-3d-fallback .ch__fallback {
    display: block;
  }

  .ch__top,
  .ch__bottom {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.9rem;
  }

  .ch__top {
    padding-top: 6.5rem;
  }

  .ch__bottom {
    padding-bottom: clamp(1.5rem, 5vh, 3rem);
  }

  .ch__crumb {
    justify-content: center;
  }

  .ch__title {
    font-size: clamp(1.9rem, 1.1rem + 2.4vw, 3.3rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    font-weight: 450;
    max-width: 26ch;
  }

  .ch__lead {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--text-muted);
    max-width: 40rem;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    border-radius: 12px;
  }

  .ch__actions {
    justify-content: center;
  }

  /* ---------- L'abri : visuel collant + texte qui défile ---------- */
  .cs {
    position: relative;
    z-index: 1;
    border-bottom: 1px solid var(--line);
  }

  .cs__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .cs__visual {
    position: sticky;
    top: 4.5rem;
    height: 42vh;
    z-index: 0;
    background: var(--bg);
  }

  .cs__canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .cs__text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 6rem;
    padding-block: 3rem 8rem;
  }

  .cs__group {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cs__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .cs__item {
    padding: 1.5rem;
    border-radius: 18px;
    background: var(--bg);
    border: 1px solid var(--line);
    opacity: 0.45;
    transition: opacity 500ms var(--ease-out), border-color 500ms var(--ease-out);
  }

  .cs__item.is-active {
    opacity: 1;
    border-color: color-mix(in srgb, var(--activity-tint) 40%, var(--line));
  }

  .cs__item--situation {
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .cs__title {
    font-size: 1.375rem;
    font-weight: 500;
    margin-bottom: 0.4rem;
  }

  .cs__desc {
    color: var(--text-muted);
    line-height: 1.55;
  }

  @media (min-width: 960px) {
    .cs__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
    }
    .cs__visual {
      top: 0;
      height: 100vh;
      display: flex;
      align-items: center;
    }
    .cs__canvas {
      height: 80vh;
    }
    .cs__text {
      padding-block: 30vh 30vh;
      gap: 40vh;
    }
    .cs__list {
      gap: 30vh;
    }
  }

  /* ---------- Interlocuteurs ---------- */
  .cw {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .cw {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 3rem;
    }
  }

  .cw li {
    padding-block: 2rem;
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .cw__name {
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
    font-weight: 450;
    letter-spacing: -0.02em;
    color: var(--activity-tint);
  }

  .cw__desc {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--text-muted);
    max-width: 34rem;
  }

  .cp {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: 28px;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .cp__text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 46rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .ch {
      height: auto;
    }
    .ch__stage {
      position: relative;
    }
    .cs__item {
      transition: none;
    }
  }
</style>
