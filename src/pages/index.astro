---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLogo, { type BrandKey } from '../components/BrandLogo.astro';
import {
  SHOW_TEAM,
  TEAM_MEMBERS,
  SHOW_HERO_VIDEO,
  HERO_VIDEO_URL,
} from '../config/flags';
import '../styles/activity-3d.css';

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'SSE Solutions',
  alternateName: 'SSE Solutions — Social, Security and Events',
  url: 'https://ssesolutions.fr',
  email: ['cccare@ssesolutions.fr', 'ccconsulting@ssesolutions.fr'],
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'Essonne',
  },
};

interface SolutionCard {
  id: string;
  tintKey: 'care' | 'autonomie' | 'consulting' | 'events';
  transitionName: string;
  brand: BrandKey;
  name: string;
  href: string;
  pitch: string;
  tags: string[];
  problem: string;
  solution: string;
  audience: string;
  ctaLabel: string;
}

const solutions: SolutionCard[] = [
  {
    id: 'cc-care',
    tintKey: 'care',
    transitionName: 'solution-card-care',
    brand: 'cc-care',
    name: 'CC Care',
    href: '/cc-care',
    pitch:
      'Un accompagnement social sur-mesure pour vos bénéficiaires, résidents et équipes : permanence sociale, diagnostic et coordination d’accès aux droits pour éviter les ruptures de parcours.',
    tags: ['Permanence sociale', 'Accès aux droits', 'Sur site & à distance'],
    problem:
      'Des dossiers sociaux qui s’accumulent, des équipes débordées, des situations individuelles qui demandent du temps et un cadre clair.',
    solution:
      'Un accompagnement social sur site ou à distance, des ateliers collectifs et des écrits clairs pour vos équipes.',
    audience: 'Structures sociales et entreprises.',
    ctaLabel: 'Découvrir CC Care',
  },
  {
    id: 'autonomie-inclusion',
    tintKey: 'autonomie',
    transitionName: 'solution-card-autonomie',
    brand: 'cc-care',
    name: 'Autonomie & Inclusion',
    href: '/cc-care/autonomie-inclusion',
    pitch:
      'Le programme opérationnel de 35 modules et 244 ateliers pour développer l’autonomie quotidienne, le budget et le logement, en français courant et FALC.',
    tags: ['35 modules pratiques', '244 ateliers concrets', 'Français & FALC'],
    problem:
      'Des adultes accompagnés qui peinent avec les démarches, le budget, le logement ou le numérique, faute de supports adaptés.',
    solution:
      'Un programme en ligne de 35 modules et 244 ateliers, chacun en deux versions : français courant et FALC (Facile à lire et à comprendre).',
    audience:
      'Structures sociales, médico-sociales et d’insertion qui veulent équiper leurs équipes.',
    ctaLabel: 'Découvrir Autonomie & Inclusion',
  },
  {
    id: 'cc-consulting',
    tintKey: 'consulting',
    transitionName: 'solution-card-consulting',
    brand: 'cc-consulting',
    name: 'CC Consulting',
    href: '/cc-consulting',
    pitch:
      'Audit réglementaire, préparation rigoureuse aux commissions de sécurité, mise à jour des registres et schémas d’évacuation conformes aux exigences préfectorales.',
    tags: ['Conformité ERP', 'Commissions de sécurité', 'Levée de prescriptions'],
    problem:
      'Une commission de sécurité qui approche, un registre incomplet, des prescriptions difficiles à prioriser.',
    solution:
      'Un diagnostic sur site, un plan d’action priorisé et une présence à vos côtés avant, pendant et après la visite.',
    audience:
      'Directeurs et responsables sécurité d’établissements recevant du public (types J, U, O, R, W, M…).',
    ctaLabel: 'Découvrir CC Consulting',
  },
  {
    id: 'cc-events',
    tintKey: 'events',
    transitionName: 'solution-card-events',
    brand: 'cc-events',
    name: 'CC Events',
    href: '/cc-events',
    pitch:
      'Organisation clé en main de vos temps forts institutionnels et associatifs : rétroplanning minutieux, coordination des prestataires et pilotage terrain sans faille.',
    tags: ['Régie générale', 'Rétroplanning 360°', 'Présence terrain J-J'],
    problem:
      'Un événement à organiser sans équipe dédiée, des prestataires à coordonner, un jour J qui ne laisse pas droit à l’erreur.',
    solution:
      'Conception, rétroplanning, coordination des prestataires et présence sur le terrain du montage au démontage.',
    audience: 'Entreprises, institutions et associations qui organisent un événement.',
    ctaLabel: 'Découvrir CC Events',
  },
];
---
<BaseLayout
  title="SSE Solutions · Accompagnement social, sécurité incendie et événementiel en Essonne"
  description="Accompagnement social, sécurité incendie des ERP, événementiel : nous intervenons en Essonne auprès des établissements de santé et des entreprises."
  jsonLd={organizationJsonLd}
  livingMesh={false}
>
  <!-- Une maison, trois métiers : le logo se sépare en trois univers au défilement -->
  <div class="hm" data-home>
    <div class="hm__stage">
      <canvas class="hm__canvas" data-home-canvas aria-hidden="true"></canvas>
      <div class="hm__fallback" aria-hidden="true">
        <BrandLogo brand="sse-solutions" size="xl" loading="eager" alt="" />
      </div>

      <div class="hm__intro container">
        <h1 class="hm__title">L’allié terrain pour vos équipes, vos établissements et vos événements.</h1>
        <p class="hm__verbs">Social. Sécurité. Événements.</p>
        <div class="act-actions hm__actions">
          <a href="#solutions" class="act-btn">Découvrir nos solutions</a>
          <a href="/contact" class="act-btn act-btn--ghost">Nous écrire</a>
        </div>
      </div>

      <div class="hm__house container" aria-hidden="true">
        <p class="hm__house-title">Une seule maison</p>
        <p class="hm__house-text">Un interlocuteur unique pour coordonner le social, la sécurité et l'événementiel.</p>
      </div>

      <nav class="hm__doors container" aria-label="Nos trois activités">
        <a class="hm__door" href="/cc-care">
          <span class="hm__door-letter">S</span>
          <span class="hm__door-name">CC Care</span>
          <span class="hm__door-sub">Social</span>
        </a>
        <a class="hm__door" href="/cc-consulting">
          <span class="hm__door-letter">S</span>
          <span class="hm__door-name">CC Consulting</span>
          <span class="hm__door-sub">Sécurité Incendie</span>
        </a>
        <a class="hm__door" href="/cc-events">
          <span class="hm__door-letter">E</span>
          <span class="hm__door-name">CC Events</span>
          <span class="hm__door-sub">Événementiel</span>
        </a>
      </nav>
    </div>
  </div>

  <section class="act-block hm-idea" aria-label="Notre idée">
    <div class="container hm-idea__inner">
      {
        SHOW_HERO_VIDEO && HERO_VIDEO_URL && (
          <div class="hm-idea__video">
            <video src={HERO_VIDEO_URL} controls playsinline preload="metadata" />
          </div>
        )
      }
      <p class="hm-idea__text" data-reveal>
        SSE Solutions réunit trois activités qui partagent une même méthode : écouter, comprendre, agir et accompagner.
      </p>
    </div>
  </section>

  <section class="act-block" id="solutions" aria-labelledby="hm-sol-title">
    <div class="container act-block__inner">
      <h2 class="act-section-title" id="hm-sol-title" data-reveal>Quatre réponses concrètes, selon votre besoin.</h2>
      <ol class="hm-sol" role="list">
        {solutions.map((item) => (
          <li class={`hm-sol__item hm-sol__item--${item.tintKey}`} data-reveal>
            <div class="hm-sol__head">
              <h3 class="hm-sol__name">{item.name}</h3>
              <p class="hm-sol__pitch">{item.pitch}</p>
              <p class="hm-sol__tags">{item.tags.join(' · ')}</p>
            </div>
            <dl class="hm-sol__details">
              <div><dt>Le problème</dt><dd>{item.problem}</dd></div>
              <div><dt>Ce que nous apportons</dt><dd>{item.solution}</dd></div>
              <div><dt>Pour qui</dt><dd>{item.audience}</dd></div>
            </dl>
            <a href={item.href} class="hm-sol__link">{item.ctaLabel} <span aria-hidden="true">→</span></a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="act-block" id="methode" aria-labelledby="hm-method-title">
    <div class="container act-block__inner">
      <h2 class="act-section-title" id="hm-method-title" data-reveal>Écouter, comprendre, agir et accompagner.</h2>
      <ol class="hm-method" role="list" data-reveal>
        <li><span class="hm-method__dot" aria-hidden="true"></span><h3>Écouter.</h3><p>Nous partons de votre situation, de vos contraintes et de vos échéances.</p></li>
        <li><span class="hm-method__dot" aria-hidden="true"></span><h3>Diagnostiquer.</h3><p>Nous faisons un état des lieux précis et écrit.</p></li>
        <li><span class="hm-method__dot" aria-hidden="true"></span><h3>Agir.</h3><p>Nous menons les actions avec vous et coordonnons les bons interlocuteurs.</p></li>
        <li><span class="hm-method__dot" aria-hidden="true"></span><h3>Accompagner.</h3><p>Nous restons présents à vos côtés jusqu’au résultat, et dans la durée.</p></li>
      </ol>
    </div>
  </section>

  <section class="act-block" id="engagements" aria-labelledby="hm-eng-title">
    <div class="container act-block__inner">
      <h2 class="act-section-title" id="hm-eng-title" data-reveal>Ce que vous pouvez attendre de nous.</h2>
      <ul class="act-grid hm-eng" role="list" data-reveal>
        <li class="act-card"><h3 class="act-card__title">Un interlocuteur.</h3><p>Une personne qui connaît votre dossier, du premier échange au dernier.</p></li>
        <li class="act-card"><h3 class="act-card__title">Des écrits clairs.</h3><p>Des comptes rendus courts, datés et compréhensibles par tous.</p></li>
        <li class="act-card"><h3 class="act-card__title">Le terrain.</h3><p>Des solutions pensées pour votre établissement, pas pour un modèle type.</p></li>
        <li class="act-card"><h3 class="act-card__title">La discrétion.</h3><p>Les situations sociales et les informations de sécurité restent confidentielles.</p></li>
      </ul>
    </div>
  </section>

  {
    SHOW_TEAM && TEAM_MEMBERS.length > 0 && (
      <section class="act-block" id="equipe" aria-labelledby="hm-team-title">
        <div class="container act-block__inner">
          <h2 class="act-section-title" id="hm-team-title" data-reveal>Qui est derrière SSE Solutions</h2>
          <ul class="act-grid act-grid--3" role="list">
            {TEAM_MEMBERS.map((member) => (
              <li class="act-card" data-reveal>
                {member.photo && (
                  <img src={member.photo} alt={member.name} width="480" height="480" loading="lazy" decoding="async" class="hm-team__photo" />
                )}
                <h3 class="act-card__title">{member.name}</h3>
                <p>{member.role}</p>
                <p>{member.diploma}</p>
                <p>{member.experienceYears}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="act-block act-cta-wrap" aria-labelledby="hm-cta-title">
    <div class="container">
      <div class="act-cta" data-reveal>
        <div class="act-cta__text">
          <h2 class="act-section-title" id="hm-cta-title">Parlons de votre projet.</h2>
          <p class="hm-cta__text">Dites-nous en quelques lignes ce dont vous avez besoin. Nous vous répondons sous 48 heures ouvrées.</p>
        </div>
        <a href="/contact" class="act-btn act-btn--invert">Nous écrire</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initHomePage } from '../scripts/home/page.js';

  let cleanup: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    cleanup = document.querySelector('[data-home]') ? initHomePage() : null;
  });
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>

<style>
  /* ---------- Une maison, trois métiers ---------- */
  .hm {
    --hp: 0;
    position: relative;
    height: 340vh;
  }

  .hm__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    min-height: 40rem;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .hm__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1s var(--ease-out);
  }

  .hm.is-3d-ready .hm__canvas {
    opacity: 1;
  }

  .hm__fallback {
    display: none;
    position: absolute;
    top: 16%;
    left: 50%;
    transform: translateX(-50%);
    width: min(60%, 26rem);
  }

  .hm.is-3d-fallback .hm__fallback {
    display: block;
  }

  .hm__intro,
  .hm__house,
  .hm__doors {
    position: absolute;
    left: 0;
    right: 0;
    text-align: center;
  }

  .hm__intro {
    bottom: clamp(2rem, 7vh, 4.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    opacity: clamp(0, (0.3 - var(--hp)) / 0.12, 1);
    transform: translateY(calc((1 - clamp(0, (0.3 - var(--hp)) / 0.12, 1)) * -24px));
    pointer-events: auto;
  }

  .hm__title {
    font-size: clamp(2rem, 1.1rem + 3vw, 3.75rem);
    line-height: 1.06;
    letter-spacing: -0.025em;
    font-weight: 450;
    max-width: 22ch;
  }

  .hm__verbs {
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    color: var(--text-muted);
  }

  .hm__actions {
    justify-content: center;
  }

  .hm__house {
    bottom: clamp(2rem, 8vh, 5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    opacity: clamp(0, min((var(--hp) - 0.3) / 0.1, (0.62 - var(--hp)) / 0.08), 1);
  }

  .hm__house-title {
    font-size: clamp(2rem, 1.2rem + 3vw, 4rem);
    font-weight: 450;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }

  .hm__house-text {
    font-size: 1.125rem;
    color: var(--text-muted);
    max-width: 34rem;
  }

  .hm__doors {
    bottom: clamp(1.5rem, 6vh, 3.5rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    opacity: clamp(0, (var(--hp) - 0.74) / 0.12, 1);
    transform: translateY(calc((1 - clamp(0, (var(--hp) - 0.74) / 0.12, 1)) * 20px));
    pointer-events: none;
  }

  .hm.is-doors .hm__doors {
    pointer-events: auto;
  }

  .hm__door {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    padding: 1rem;
    border-radius: 18px;
    color: var(--text);
    text-decoration: none;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    border: 1px solid var(--line);
    transition: border-color 200ms var(--ease-out), background-color 200ms var(--ease-out);
  }

  .hm__door:hover,
  .hm__door:focus-visible {
    border-color: color-mix(in srgb, var(--text) 30%, transparent);
    background: var(--bg);
  }

  .hm__door:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 3px;
  }

  .hm__door-letter {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .hm__door-name {
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    font-weight: 500;
  }

  .hm__door-sub {
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  /* Mobile : les trois univers sont empilés, les portes à droite de chacun */
  @media (max-width: 760px) {
    .hm__doors {
      grid-template-columns: minmax(0, 1fr);
      top: 5.5rem;
      bottom: 1.5rem;
      align-content: space-between;
      justify-items: end;
    }
    .hm__door {
      align-items: flex-end;
      padding: 0.6rem 0.9rem;
    }
  }

  /* ---------- Sections ---------- */
  .hm-idea__inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .hm-idea__text {
    font-size: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 450;
    max-width: 28ch;
  }

  .hm-idea__video video {
    width: 100%;
    border-radius: 20px;
  }

  .hm-sol {
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .hm-sol__item {
    --tint: var(--text);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 2.5rem;
    border-bottom: 1px solid var(--line);
  }

  .hm-sol__item--care { --tint: var(--tint-care); }
  .hm-sol__item--autonomie { --tint: var(--tint-autonomie); }
  .hm-sol__item--consulting { --tint: var(--tint-consulting); }
  .hm-sol__item--events { --tint: var(--tint-events); }

  @media (min-width: 960px) {
    .hm-sol__item {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.4fr);
      grid-template-areas: 'head details' 'link details';
      column-gap: 4rem;
    }
    .hm-sol__head { grid-area: head; }
    .hm-sol__details { grid-area: details; }
    .hm-sol__link { grid-area: link; align-self: end; }
  }

  .hm-sol__head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hm-sol__name {
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
    font-weight: 450;
    letter-spacing: -0.02em;
    color: var(--tint);
  }

  .hm-sol__pitch {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--text);
  }

  .hm-sol__tags {
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  .hm-sol__details {
    display: grid;
    gap: 1.25rem;
  }

  .hm-sol__details dt {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }

  .hm-sol__details dd {
    font-size: 1rem;
    line-height: 1.55;
  }

  .hm-sol__link {
    color: var(--text);
    font-weight: 500;
    text-underline-offset: 4px;
  }

  .hm-method {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    position: relative;
  }

  @media (min-width: 900px) {
    .hm-method {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      border-top: 1px solid var(--line);
      padding-top: 2rem;
    }
  }

  .hm-method li {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hm-method__dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--text);
    margin-bottom: 0.5rem;
  }

  .hm-method h3 {
    font-size: 1.5rem;
    font-weight: 500;
  }

  .hm-method p {
    color: var(--text-muted);
    line-height: 1.55;
  }

  @media (min-width: 900px) {
    .hm-eng {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .hm-team__photo {
    width: 100%;
    height: auto;
    border-radius: 14px;
  }

  .hm-cta__text {
    color: var(--bg);
    opacity: 0.8;
    max-width: 36rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .hm {
      height: auto;
    }
    .hm__stage {
      position: relative;
    }
  }
</style>
