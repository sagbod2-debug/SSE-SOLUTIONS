---
import BaseLayout from '../layouts/BaseLayout.astro';
import Picture from '../components/Picture.astro';
import LivingMesh from '../components/LivingMesh.astro';
import { SHOW_TEAM, TEAM_MEMBERS } from '../config/flags';

// TODO logo officiel : remplacer la composition typographique de la section « Trois lettres. Une seule maison. » par le SVG ou PNG transparent officiel (< 40 Ko) dès réception.

const marqueeText =
  "Accompagnement social · Sécurité incendie · Établissements recevant du public · Événementiel · Autonomie au quotidien · Commissions de sécurité · Coordination d'équipes · ";

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'SSE Solutions',
  alternateName: 'SSE Solutions — Social, Security and Events',
  url: 'https://ssesolutions.fr',
  email: ['cccare@ssesolutions.fr', 'ccconsulting@ssesolutions.fr'],
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'Essonne',
  },
};
---

<BaseLayout
  title="SSE Solutions · Accompagnement social, sécurité incendie et événementiel en Essonne"
  description="Accompagnement social, sécurité incendie des ERP, événementiel : nous intervenons en Essonne auprès des établissements de santé et des entreprises."
  jsonLd={organizationJsonLd}
>
  <!-- 1. HERO AVEC ARRIÈRE-PLAN VIVANT WEBGL + ARCHITECTURE EN FONDU SUR LA MOITIÉ DROITE -->
  <section class="hero-home">
    <LivingMesh />

    <div class="hero-bg-media" aria-hidden="true">
      <Picture
        slug="01-hero-architecture"
        alt="Architecture minimaliste en béton brut éclairée par une lumière rasante, créant des lignes géométriques sobres"
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        parallax={false}
      />
      <div class="hero-bg-overlay"></div>
    </div>

    <div class="container hero-home-inner">
      <div class="hero-content">
        <p class="eyebrow" data-hero-fade>SSE SOLUTIONS · ESSONNE</p>

        <h1 class="hero-title" data-hero-fade>
          Un seul partenaire pour les personnes, les lieux et les grands moments.
        </h1>

        <p class="hero-trilogy" aria-label="Social. Sécurité. Événements.">
          <span class="reveal-mask">
            <span class="reveal-line" data-hero-line>Social<span class="dot-gold">.</span></span>
          </span>
          <span class="reveal-mask">
            <span class="reveal-line" data-hero-line>Sécurité<span class="dot-gold">.</span></span>
          </span>
          <span class="reveal-mask">
            <span class="reveal-line" data-hero-line>Événements<span class="dot-gold">.</span></span>
          </span>
        </p>

        <p class="hero-lead prose-measure" data-hero-fade>
          Accompagnement social, sécurité incendie des établissements recevant du public, événementiel : nous intervenons en Essonne auprès des établissements de santé, des structures sociales et des entreprises.
        </p>

        <div class="btn-group hero-actions" data-hero-fade>
          <a href="#activites" class="btn-primary" data-magnetic data-glow>
            <span>Trouver la bonne activité</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
          <a href="/contact" class="btn-secondary glass" data-glow>
            <span>Nous écrire</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
        </div>

        <nav class="hero-needs-nav" aria-label="Aiguillage rapide par besoin" data-hero-fade>
          <a
            href="/cc-care"
            class="need-pill glass need-pill--care"
            data-activity-pill="cc-care"
            data-glow
          >
            <span class="need-pill-dot" aria-hidden="true"></span>
            <span class="need-pill-text">Une situation sociale à accompagner</span>
            <span class="need-pill-arrow" aria-hidden="true">→</span>
          </a>
          <a
            href="/cc-consulting"
            class="need-pill glass need-pill--consulting"
            data-activity-pill="cc-consulting"
            data-glow
          >
            <span class="need-pill-dot" aria-hidden="true"></span>
            <span class="need-pill-text">Une commission de sécurité approche</span>
            <span class="need-pill-arrow" aria-hidden="true">→</span>
          </a>
          <a
            href="/cc-events"
            class="need-pill glass need-pill--events"
            data-activity-pill="cc-events"
            data-glow
          >
            <span class="need-pill-dot" aria-hidden="true"></span>
            <span class="need-pill-text">Un événement à organiser</span>
            <span class="need-pill-arrow" aria-hidden="true">→</span>
          </a>
        </nav>
      </div>

      <div class="hero-scroll-indicator" data-hero-fade>
        <a href="#activites" class="scroll-indicator-link">
          <span class="scroll-line" aria-hidden="true"></span>
          <span>Défiler</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 2. BANDEAU DÉFILANT -->
  <section class="marquee-band" aria-label="Métiers de SSE Solutions">
    <div class="marquee-track">
      <span class="marquee-item">{marqueeText}</span>
      <span class="marquee-item" aria-hidden="true">{marqueeText}</span>
      <span class="marquee-item" aria-hidden="true">{marqueeText}</span>
    </div>
  </section>

  <!-- 3. SECTION ACTIVITÉS -->
  <section class="section section--spacious" id="activites">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow" data-reveal>NOS ACTIVITÉS</p>
        <h2 class="section-title" data-reveal-title>
          <span class="reveal-mask">
            <span class="reveal-line">Une entreprise. Trois métiers.</span>
          </span>
        </h2>
      </div>

      <div class="activities-wrapper" data-activities-interactive>
        <div class="activities-floating-preview" id="activities-floating-preview" aria-hidden="true">
          <div class="preview-slide is-active" data-preview-slide="01">
            <Picture
              slug="02-accueil-cc-care"
              alt="Deux personnes assises autour d’une table examinant ensemble des documents administratifs dans un cadre calme"
              sizes="360px"
              parallax={false}
            />
          </div>
          <div class="preview-slide" data-preview-slide="02">
            <Picture
              slug="03-accueil-cc-consulting"
              alt="Couloir épuré et dégagé d’un établissement contemporain aux lignes sobres et éclairage maîtrisé"
              sizes="360px"
              parallax={false}
            />
          </div>
          <div class="preview-slide" data-preview-slide="03">
            <Picture
              slug="04-accueil-cc-events"
              alt="Grande salle de réception et scène éclairée lors d’un événement professionnel, public vu de dos"
              sizes="360px"
              parallax={false}
            />
          </div>
        </div>

        <ul class="activities-list">
          <!-- 01 CC Care -->
          <li
            class="activity-row activity-row--care"
            data-activity-row="01"
            data-tilt-card
            data-glow
            data-reveal
          >
            <div class="activity-mobile-photo media-frame">
              <Picture
                slug="02-accueil-cc-care"
                alt="Deux personnes assises autour d’une table examinant ensemble des documents administratifs dans un cadre calme"
                sizes="(max-width: 960px) 92vw, 360px"
                parallax={false}
                transitionName="activity-hero-care"
              />
            </div>
            <a href="/cc-care" class="activity-link">
              <div class="activity-meta">
                <span class="num-index activity-num">01</span>
                <span class="activity-badge glass">Social</span>
              </div>
              <div class="activity-main">
                <h3 class="activity-name">CC Care</h3>
                <p class="activity-desc">
                  Accompagnement social en établissement de santé, en structure sociale et en entreprise.
                </p>
              </div>
              <span class="activity-arrow" aria-hidden="true">→</span>
            </a>
          </li>

          <!-- 02 CC Consulting -->
          <li
            class="activity-row activity-row--consulting"
            data-activity-row="02"
            data-tilt-card
            data-glow
            data-reveal
          >
            <div class="activity-mobile-photo media-frame">
              <Picture
                slug="03-accueil-cc-consulting"
                alt="Couloir épuré et dégagé d’un établissement contemporain aux lignes sobres et éclairage maîtrisé"
                sizes="(max-width: 960px) 92vw, 360px"
                parallax={false}
                transitionName="activity-hero-consulting"
              />
            </div>
            <a href="/cc-consulting" class="activity-link">
              <div class="activity-meta">
                <span class="num-index activity-num">02</span>
                <span class="activity-badge glass">Sécurité</span>
              </div>
              <div class="activity-main">
                <h3 class="activity-name">CC Consulting</h3>
                <p class="activity-desc">
                  Mise en conformité incendie des établissements recevant du public et préparation aux commissions de sécurité.
                </p>
              </div>
              <span class="activity-arrow" aria-hidden="true">→</span>
            </a>
          </li>

          <!-- 03 CC Events -->
          <li
            class="activity-row activity-row--events"
            data-activity-row="03"
            data-tilt-card
            data-glow
            data-reveal
          >
            <div class="activity-mobile-photo media-frame">
              <Picture
                slug="04-accueil-cc-events"
                alt="Grande salle de réception et scène éclairée lors d’un événement professionnel, public vu de dos"
                sizes="(max-width: 960px) 92vw, 360px"
                parallax={false}
                transitionName="activity-hero-events"
              />
            </div>
            <a href="/cc-events" class="activity-link">
              <div class="activity-meta">
                <span class="num-index activity-num">03</span>
                <span class="activity-badge glass">Événementiel</span>
              </div>
              <div class="activity-main">
                <h3 class="activity-name">CC Events</h3>
                <p class="activity-desc">
                  Organisation de grands événements et coordination des équipes sur le terrain.
                </p>
              </div>
              <span class="activity-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 4. SECTION À PROPOS -->
  <section class="section section--secondary section--spacious">
    <div class="container grid-12 about-grid">
      <div class="about-left">
        <p class="eyebrow" data-reveal>QUI SOMMES-NOUS</p>
        <h2 class="section-title" data-reveal-title>
          <span class="reveal-mask">
            <span class="reveal-line">Trois lettres.</span>
          </span>
          <span class="reveal-mask">
            <span class="reveal-line">Une seule maison.</span>
          </span>
        </h2>
      </div>

      <div class="about-right" data-reveal>
        <p class="about-text prose-measure">
          SSE Solutions porte les initiales de ses trois métiers : Social, Security and Events. Chaque activité a son savoir-faire, son interlocuteur et sa marque. Toutes partagent la même façon de travailler : comprendre avant d'agir, écrire clairement, suivre jusqu'au bout.
        </p>

        <div class="about-logo-box">
          <div class="brand-wordmark-large" aria-label="SSE Solutions — Social, Security and Events">
            <span class="brand-wordmark-sse">SSE</span>
            <span class="brand-wordmark-rule" aria-hidden="true"></span>
            <span class="brand-wordmark-solutions">Solutions</span>
          </div>
        </div>
      </div>
    </div>

    {SHOW_TEAM && TEAM_MEMBERS.length > 0 && (
      <div class="container team-subsection">
        <div class="section-header">
          <p class="eyebrow" data-reveal>ÉQUIPE</p>
          <h3 class="section-title" data-reveal-title>
            <span class="reveal-mask">
              <span class="reveal-line">Qui est derrière SSE Solutions</span>
            </span>
          </h3>
        </div>

        <ul class="team-grid grid-12">
          {TEAM_MEMBERS.map((member) => (
            <li class="team-card glass" data-glow data-reveal>
              {member.photo && (
                <div class="team-photo media-frame">
                  <img
                    src={member.photo}
                    alt={member.name}
                    width="480"
                    height="480"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
              <div class="team-body">
                <h4 class="card-title">{member.name}</h4>
                <p class="team-role">{member.role}</p>
                <p class="team-meta">{member.diploma}</p>
                <p class="team-meta">{member.experienceYears}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>

  <!-- 5. SECTION PROGRAMME (MISE EN AVANT) -->
  <section class="section section--spacious programme-highlight">
    <div class="container">
      <div class="grid-12 programme-grid">
        <div class="programme-content">
          <p class="eyebrow eyebrow--care" data-reveal>NOUVEAU · CC CARE</p>
          <h2 class="section-title" data-reveal-title>
            <span class="reveal-mask">
              <span class="reveal-line">Autonomie &amp; Inclusion.</span>
            </span>
          </h2>
          <p class="prose-measure programme-desc" data-reveal>
            Un programme en ligne pour aider les adultes accompagnés par les structures sociales à gagner en autonomie au quotidien. Chaque atelier existe en français courant et en version FALC (Facile à lire et à comprendre), relue par des personnes concernées avant diffusion.
          </p>

          <dl class="stats-grid" data-reveal>
            <div class="stat-item">
              <dt class="stat-label">modules thématiques</dt>
              <dd class="stat-value" data-count-to="35">35</dd>
            </div>
            <div class="stat-item">
              <dt class="stat-label">ateliers</dt>
              <dd class="stat-value" data-count-to="244">244</dd>
            </div>
            <div class="stat-item">
              <dt class="stat-label">versions de chaque atelier : FALC et français courant</dt>
              <dd class="stat-value" data-count-to="2">2</dd>
            </div>
          </dl>

          <div class="btn-group" data-reveal>
            <a href="/cc-care/autonomie-inclusion" class="btn-primary" data-magnetic data-glow>
              <span>Découvrir le programme</span>
              <span class="btn-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <div class="programme-media" data-reveal>
          <div class="media-frame programme-frame">
            <Picture
              slug="05-accueil-programme"
              alt="Personne adulte utilisant un ordinateur portable sur une table en bois baignée de lumière naturelle"
              sizes="(max-width: 960px) 92vw, 520px"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. SECTION MÉTHODE (ÉPINGLÉE, 4 ÉTAPES) -->
  <section class="section section--secondary method-section" data-method-pin id="methode">
    <div class="container grid-12 method-grid">
      <div class="method-header">
        <p class="eyebrow" data-reveal>NOTRE MÉTHODE</p>
        <h2 class="section-title" data-reveal-title>
          <span class="reveal-mask">
            <span class="reveal-line">Comprendre</span>
          </span>
          <span class="reveal-mask">
            <span class="reveal-line">avant d'agir.</span>
          </span>
        </h2>
      </div>

      <div class="method-timeline">
        <div class="method-rail" aria-hidden="true">
          <div class="method-rail-progress" data-method-progress></div>
        </div>

        <ol class="method-steps">
          <li class="method-step is-active">
            <span class="num-index">01</span>
            <div class="method-step-body">
              <h3 class="card-title">Écouter.</h3>
              <p class="prose-measure">
                Nous partons de votre situation, de vos contraintes et de vos échéances.
              </p>
            </div>
          </li>
          <li class="method-step">
            <span class="num-index">02</span>
            <div class="method-step-body">
              <h3 class="card-title">Diagnostiquer.</h3>
              <p class="prose-measure">
                Nous faisons un état des lieux précis et écrit, sans jargon.
              </p>
            </div>
          </li>
          <li class="method-step">
            <span class="num-index">03</span>
            <div class="method-step-body">
              <h3 class="card-title">Agir.</h3>
              <p class="prose-measure">
                Nous menons les actions avec vous et coordonnons les bons interlocuteurs.
              </p>
            </div>
          </li>
          <li class="method-step">
            <span class="num-index">04</span>
            <div class="method-step-body">
              <h3 class="card-title">Suivre.</h3>
              <p class="prose-measure">
                Nous restons présents jusqu'au résultat, et au-delà si besoin.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- 7. SECTION ENGAGEMENTS (4 POINTS NUMÉROTÉS) -->
  <section class="section section--spacious">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow" data-reveal>NOS ENGAGEMENTS</p>
        <h2 class="section-title" data-reveal-title>
          <span class="reveal-mask">
            <span class="reveal-line">Ce que vous pouvez attendre de nous.</span>
          </span>
        </h2>
      </div>

      <ol class="commitments-grid grid-12">
        <li class="commitment-card glass" data-glow data-reveal>
          <span class="num-index">01</span>
          <h3 class="card-title">Un interlocuteur.</h3>
          <p>Une personne qui connaît votre dossier, du premier échange au dernier.</p>
        </li>
        <li class="commitment-card glass" data-glow data-reveal>
          <span class="num-index">02</span>
          <h3 class="card-title">Des écrits clairs.</h3>
          <p>Des comptes rendus courts, datés et compréhensibles par tous.</p>
        </li>
        <li class="commitment-card glass" data-glow data-reveal>
          <span class="num-index">03</span>
          <h3 class="card-title">Le terrain.</h3>
          <p>Des solutions pensées pour votre établissement, pas pour un modèle type.</p>
        </li>
        <li class="commitment-card glass" data-glow data-reveal>
          <span class="num-index">04</span>
          <h3 class="card-title">La discrétion.</h3>
          <p>Les situations sociales et les informations de sécurité restent confidentielles.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- 8. SECTION CONTACT (FIN DE PAGE AVEC ARRIÈRE-PLAN VIVANT WEBGL) -->
  <section class="section section--spacious cta-final">
    <LivingMesh />
    <div class="container grid-12">
      <div class="cta-final-inner">
        <h2 class="section-title" data-reveal-title>
          <span class="reveal-mask">
            <span class="reveal-line">Parlons de votre projet.</span>
          </span>
        </h2>
        <p class="prose-measure cta-final-text" data-reveal>
          Dites-nous en quelques lignes ce dont vous avez besoin. Nous vous répondons sous 48 heures ouvrées.
        </p>
        <div class="btn-group" data-reveal>
          <a href="/contact" class="btn-primary" data-magnetic data-glow>
            <span>Nous écrire</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* 1. HERO */
  .hero-home {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    padding-top: 7.5rem;
    padding-bottom: var(--space-40);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    isolation: isolate;
  }

  /* 2.2 Image d'architecture en fondu par-dessus le dégradé (mask-image linéaire 0 à 100 % sur la moitié droite) */
  .hero-bg-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, transparent 45%, #000 100%);
    mask-image: linear-gradient(90deg, transparent 0%, transparent 45%, #000 100%);
    pointer-events: none;
  }

  .hero-bg-media :global(.picture-placeholder),
  .hero-bg-media :global(picture),
  .hero-bg-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.34;
    filter: grayscale(35%) contrast(1.05);
  }

  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--hero-scrim-start) 0%, var(--hero-scrim-end) 100%);
  }

  .hero-home-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-64);
    width: 100%;
  }

  .hero-content {
    max-width: 64rem;
  }

  .hero-title {
    font-size: clamp(2.15rem, 1.35rem + 3.2vw, 3.85rem);
    max-width: 24ch;
  }

  .hero-trilogy {
    margin-top: var(--space-24);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.5rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.45em;
  }

  .hero-lead {
    margin-top: var(--space-24);
    font-size: clamp(1.0625rem, 1.25vw, 1.25rem);
    color: var(--text);
  }

  .hero-actions {
    margin-top: var(--space-40);
  }

  /* 5.1 Aiguillage par besoin : trois pastilles en verre (.glass) dans la teinte de leur activité */
  .hero-needs-nav {
    margin-top: var(--space-24);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .need-pill {
    --pill-tint: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.6rem 1.05rem;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--text);
    border: 1px solid color-mix(in srgb, var(--pill-tint) 38%, var(--glass-border));
    transition: border-color 250ms var(--ease-out), background-color 250ms var(--ease-out),
      transform 250ms var(--ease-out);
  }

  .need-pill--care {
    --pill-tint: var(--tint-care);
    --pointer-glow: color-mix(in srgb, var(--tint-care) 18%, transparent);
  }

  .need-pill--consulting {
    --pill-tint: var(--tint-consulting);
    --pointer-glow: color-mix(in srgb, var(--tint-consulting) 18%, transparent);
  }

  .need-pill--events {
    --pill-tint: var(--tint-events);
    --pointer-glow: color-mix(in srgb, var(--tint-events) 18%, transparent);
  }

  .need-pill-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--pill-tint);
    flex-shrink: 0;
  }

  .need-pill-arrow {
    color: var(--pill-tint);
    display: inline-block;
    transition: transform 300ms var(--ease-out);
  }

  .need-pill:hover,
  .need-pill:focus-visible {
    border-color: var(--pill-tint);
  }

  .need-pill:hover .need-pill-arrow,
