---
import BaseLayout from '../layouts/BaseLayout.astro';
import LivingMesh from '../components/LivingMesh.astro';
import BrandLogo, { type BrandKey } from '../components/BrandLogo.astro';
import {
  SHOW_TEAM,
  TEAM_MEMBERS,
  SHOW_HERO_VIDEO,
  HERO_VIDEO_URL,
} from '../config/flags';

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'SSE Solutions',
  alternateName: 'SSE Solutions — Social, Security and Events',
  url: 'https://ssesolutions.fr',
  email: ['cccare@ssesolutions.fr', 'ccconsulting@ssesolutions.fr'],
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'Essonne',
  },
};

interface SolutionCard {
  id: string;
  tintKey: 'care' | 'autonomie' | 'consulting' | 'events';
  transitionName: string;
  brand: BrandKey;
  name: string;
  href: string;
  problem: string;
  solution: string;
  audience: string;
  ctaLabel: string;
}

const solutions: SolutionCard[] = [
  {
    id: 'cc-care',
    tintKey: 'care',
    transitionName: 'solution-card-care',
    brand: 'cc-care',
    name: 'CC Care',
    href: '/cc-care',
    problem:
      'Des dossiers sociaux qui s’accumulent, des équipes débordées, des situations individuelles qui demandent du temps et un cadre clair.',
    solution:
      'Un accompagnement social sur site ou à distance, des ateliers collectifs et des écrits clairs pour vos équipes.',
    audience: 'Établissements de santé, CCAS, structures sociales, entreprises.',
    ctaLabel: 'Découvrir CC Care',
  },
  {
    id: 'autonomie-inclusion',
    tintKey: 'autonomie',
    transitionName: 'solution-card-autonomie',
    brand: 'cc-care',
    name: 'Autonomie & Inclusion',
    href: '/cc-care/autonomie-inclusion',
    problem:
      'Des adultes accompagnés qui peinent avec les démarches, le budget, le logement ou le numérique, faute de supports adaptés.',
    solution:
      'Un programme en ligne de 35 modules et 244 ateliers, chacun en deux versions : français courant et FALC (Facile à lire et à comprendre).',
    audience:
      'Structures sociales, médico-sociales et d’insertion qui veulent équiper leurs équipes.',
    ctaLabel: 'Découvrir Autonomie & Inclusion',
  },
  {
    id: 'cc-consulting',
    tintKey: 'consulting',
    transitionName: 'solution-card-consulting',
    brand: 'cc-consulting',
    name: 'CC Consulting',
    href: '/cc-consulting',
    problem:
      'Une commission de sécurité qui approche, un registre incomplet, des prescriptions difficiles à prioriser.',
    solution:
      'Un diagnostic sur site, un plan d’action priorisé et une présence à vos côtés avant, pendant et après la visite.',
    audience:
      'Directeurs et responsables sécurité d’établissements recevant du public (types J, U, O, R, W, M…).',
    ctaLabel: 'Découvrir CC Consulting',
  },
  {
    id: 'cc-events',
    tintKey: 'events',
    transitionName: 'solution-card-events',
    brand: 'cc-events',
    name: 'CC Events',
    href: '/cc-events',
    problem:
      'Un événement à organiser sans équipe dédiée, des prestataires à coordonner, un jour J qui ne laisse pas droit à l’erreur.',
    solution:
      'Conception, rétroplanning, coordination des prestataires et présence sur le terrain du montage au démontage.',
    audience: 'Collectivités, établissements et entreprises qui organisent un temps fort.',
    ctaLabel: 'Découvrir CC Events',
  },
];
---

<BaseLayout
  title="SSE Solutions · Accompagnement social, sécurité incendie et événementiel en Essonne"
  description="Accompagnement social, sécurité incendie des ERP, événementiel : nous intervenons en Essonne auprès des établissements de santé et des entreprises."
  jsonLd={organizationJsonLd}
>
  <!-- 7.5 Champ de 1 200 particules WebGL natif sur toute la hauteur de l'accueil -->
  <LivingMesh fixed={true} />

  <!-- SECTION 1 — OUVERTURE (PLEIN ÉCRAN) -->
  <section class="opening-section" data-particle-tint="care">
    <div class="container opening-inner">
      <div class="opening-logo" data-opening-item>
        <BrandLogo brand="sse-solutions" size="xl" loading="eager" alt="Logo SSE Solutions" />
      </div>

      <p class="opening-brand-name" data-opening-item>SSE Solutions</p>

      <h1 class="opening-title" data-opening-item>
        Un seul partenaire pour les personnes, les lieux et les grands moments.
      </h1>

      <p class="opening-trilogy" data-opening-item>Social. Sécurité. Événements.</p>

      <div class="opening-actions" data-opening-item>
        <a href="#solutions" class="btn-glass glass" data-magnetic data-glow>
          <span>Découvrir nos solutions</span>
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/contact" class="btn-glass btn-glass--secondary glass" data-glow>
          <span>Nous écrire</span>
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 2 — « NOTRE IDÉE » (PANNEAU QUI MONTE) -->
  <section class="idea-section" id="notre-idee" data-particle-tint="autonomie">
    <div class="container">
      <div class="idea-panel glass glass--refract" data-idea-panel>
        <div class="idea-header">
          <p class="eyebrow">NOTRE IDÉE</p>
        </div>

        <!-- Séquence animée en HTML/SVG pilotée par le défilement : les 3 activités s'assemblent en une seule maison puis se séparent -->
        <div
          class="idea-stage"
          data-idea-stage
          role="img"
          aria-label="Trois activités — CC Care, CC Consulting et CC Events — réunies au sein d’une seule maison : SSE Solutions"
        >
          <svg
            class="idea-house-svg"
            viewBox="0 0 760 260"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <!-- Lignes de convergence vers la maison centrale -->
            <path
              class="idea-connector idea-connector--left"
              data-idea-connector
              d="M150 140 C 245 140, 290 130, 380 130"
              stroke="var(--tint-care)"
              stroke-width="1.5"
              stroke-dasharray="5 5"
            />
            <path
              class="idea-connector idea-connector--center"
              data-idea-connector
              d="M380 205 L 380 130"
              stroke="var(--tint-consulting)"
              stroke-width="1.5"
              stroke-dasharray="5 5"
            />
            <path
              class="idea-connector idea-connector--right"
              data-idea-connector
              d="M610 140 C 515 140, 470 130, 380 130"
              stroke="var(--tint-events)"
              stroke-width="1.5"
              stroke-dasharray="5 5"
            />

            <!-- Silhouette de la maison commune SSE Solutions -->
            <g class="idea-roof-group" data-idea-house>
              <path
                d="M270 108 L380 38 L490 108"
                stroke="var(--text)"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <rect
                x="292"
                y="108"
                width="176"
                height="104"
                rx="18"
                stroke="var(--line)"
                stroke-width="1.5"
                fill="var(--glass-bg)"
              />
            </g>
          </svg>

          <div class="idea-nodes">
            <div class="idea-node idea-node--care glass" data-idea-node="left">
              <span class="idea-node-dot" aria-hidden="true"></span>
              <strong>CC Care</strong>
              <span>Social</span>
            </div>

            <div class="idea-node idea-node--consulting glass" data-idea-node="center">
              <span class="idea-node-dot" aria-hidden="true"></span>
              <strong>CC Consulting</strong>
              <span>Sécurité</span>
            </div>

            <div class="idea-node idea-node--events glass" data-idea-node="right">
              <span class="idea-node-dot" aria-hidden="true"></span>
              <strong>CC Events</strong>
              <span>Événementiel</span>
            </div>

            <div class="idea-house-badge glass" data-idea-core>
              <span class="idea-house-title">SSE Solutions</span>
              <span class="idea-house-sub">Une seule maison</span>
            </div>
          </div>
        </div>

        {
          SHOW_HERO_VIDEO && HERO_VIDEO_URL && (
            <div class="idea-video-slot">
              <video
                src={HERO_VIDEO_URL}
                controls
                playsinline
                preload="metadata"
                class="idea-video"
              />
            </div>
          )
        }

        <p class="idea-text">
          SSE Solutions réunit trois activités qui partagent une même méthode : comprendre avant d’agir, écrire clairement, suivre jusqu’au bout.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 3 — « NOS SOLUTIONS » (4 GRANDES CARTES QUI ARRIVENT L'UNE APRÈS L'AUTRE) -->
  <section class="solutions-section" id="solutions" data-solutions-pin>
    <div class="container solutions-container">
      <div class="solutions-header">
        <p class="eyebrow">NOS SOLUTIONS</p>
        <h2 class="section-title">Quatre réponses concrètes, selon votre besoin.</h2>
      </div>

      <div class="solutions-stack" data-solutions-stack>
        {
          solutions.map((item, index) => (
            <article
              class:list={['solution-card', `solution-card--${item.tintKey}`, 'glass', 'glass--refract']}
              data-solution-card
              data-solution-index={index}
              data-particle-tint={item.tintKey}
              transition:name={item.transitionName}
            >
              <a
                href={item.href}
                class="solution-card__link"
                aria-label={`${item.name} — ${item.ctaLabel}`}
              >
                <div class="solution-card__top">
                  <div class="solution-card__brand">
                    <BrandLogo brand={item.brand} size="md" loading="lazy" alt={`Logo ${item.name}`} />
                    <div class="solution-card__titles">
                      <span class="num-index">0{index + 1}</span>
                      <h3 class="solution-card__name">{item.name}</h3>
                    </div>
                  </div>

                  <span class="btn-glass solution-card__cta glass">
                    <span>{item.ctaLabel}</span>
                    <span class="btn-arrow" aria-hidden="true">→</span>
                  </span>
                </div>

                <dl class="solution-card__grid">
                  <div class="solution-block">
                    <dt class="solution-block__label">Le problème</dt>
                    <dd class="solution-block__text">{item.problem}</dd>
                  </div>

                  <div class="solution-block">
                    <dt class="solution-block__label">Ce que nous apportons</dt>
                    <dd class="solution-block__text">{item.solution}</dd>
                  </div>

                  <div class="solution-block">
                    <dt class="solution-block__label">Pour qui</dt>
                    <dd class="solution-block__text">{item.audience}</dd>
                  </div>
                </dl>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SECTION 4 — « COMPRENDRE AVANT D'AGIR. » (MÉTHODE) -->
  <section class="section method-section" data-method-pin id="methode" data-particle-tint="consulting">
    <div class="container grid-12 method-grid">
      <div class="method-header">
        <p class="eyebrow" data-reveal>NOTRE MÉTHODE</p>
        <h2 class="section-title" data-reveal-title>
          <span class="reveal-mask">
            <span class="reveal-line">Comprendre avant d’agir.</span>
          </span>
        </h2>
      </div>

      <div class="method-timeline">
        <div class="method-rail" aria-hidden="true">
          <div class="method-rail-progress" data-method-progress></div>
        </div>

        <ol class="method-steps">
          <li class="method-step glass is-active">
            <span class="num-index">01</span>
            <div class="method-step-body">
              <h3 class="card-title">Écouter.</h3>
              <p class="prose-measure">
                Nous partons de votre situation, de vos contraintes et de vos échéances.
              </p>
            </div>
          </li>
          <li class="method-step glass">
            <span class="num-index">02</span>
            <div class="method-step-body">
              <h3 class="card-title">Diagnostiquer.</h3>
              <p class="prose-measure">
                Nous faisons un état des lieux précis et écrit, sans jargon.
              </p>
            </div>
          </li>
          <li class="method-step glass">
            <span class="num-index">03</span>
            <div class="method-step-body">
              <h3 class="card-title">Agir.</h3>
              <p class="prose-measure">
                Nous menons les actions avec vous et coordonnons les bons interlocuteurs.
              </p>
            </div>
          </li>
          <li class="method-step glass">
            <span class="num-index">04</span>
            <div class="method-step-body">
              <h3 class="card-title">Suivre.</h3>
              <p class="prose-measure">
                Nous restons présents jusqu’au résultat, et au-delà si besoin.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- SECTION 5 — « CE QUE VOUS POUVEZ ATTENDRE DE NOUS. » (ENGAGEMENTS) -->
  <section class="section section--spacious" id="engagements" data-particle-tint="events">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow" data-reveal>NOS ENGAGEMENTS</p>
        <h2 class="section-title" data-reveal-title>
          <span class="reveal-mask">
            <span class="reveal-line">Ce que vous pouvez attendre de nous.</span>
          </span>
        </h2>
      </div>

      <ol class="commitments-grid grid-12">
        <li class="commitment-card glass" data-glow data-reveal>
          <span class="num-index">01</span>
          <h3 class="card-title">Un interlocuteur.</h3>
          <p>Une personne qui connaît votre dossier, du premier échange au dernier.</p>
        </li>
        <li class="commitment-card glass" data-glow data-reveal>
          <span class="num-index">02</span>
          <h3 class="card-title">Des écrits clairs.</h3>
          <p>Des comptes rendus courts, datés et compréhensibles par tous.</p>
        </li>
        <li class="commitment-card glass" data-glow data-reveal>
          <span class="num-index">03</span>
          <h3 class="card-title">Le terrain.</h3>
          <p>Des solutions pensées pour votre établissement, pas pour un modèle type.</p>
        </li>
        <li class="commitment-card glass" data-glow data-reveal>
          <span class="num-index">04</span>
          <h3 class="card-title">La discrétion.</h3>
          <p>Les situations sociales et les informations de sécurité restent confidentielles.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- SECTION 6 — « QUI EST DERRIÈRE SSE SOLUTIONS » (MASQUÉ PAR SHOW_TEAM=false) -->
  {
    SHOW_TEAM && TEAM_MEMBERS.length > 0 && (
      <section class="section section--spacious" id="equipe">
        <div class="container">
          <div class="section-header">
            <p class="eyebrow" data-reveal>ÉQUIPE</p>
            <h2 class="section-title" data-reveal-title>
              <span class="reveal-mask">
                <span class="reveal-line">Qui est derrière SSE Solutions</span>
              </span>
            </h2>
          </div>

          <ul class="team-grid grid-12">
            {TEAM_MEMBERS.map((member) => (
              <li class="team-card glass" data-glow data-reveal>
                {member.photo && (
                  <div class="team-photo media-frame">
                    <img
                      src={member.photo}
                      alt={member.name}
                      width="480"
                      height="480"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}
                <div class="team-body">
                  <h3 class="card-title">{member.name}</h3>
                  <p class="team-role">{member.role}</p>
                  <p class="team-meta">{member.diploma}</p>
                  <p class="team-meta">{member.experienceYears}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- SECTION 7 — « PARLONS DE VOTRE PROJET. » (CONTACT, EN .GLASS) -->
  <section class="section section--spacious cta-final" data-particle-tint="care">
    <div class="container">
      <div class="cta-final-card glass glass--refract" data-glow data-reveal>
        <h2 class="section-title" data-reveal-title>
          <span class="reveal-mask">
            <span class="reveal-line">Parlons de votre projet.</span>
          </span>
        </h2>
        <p class="prose-measure cta-final-text">
          Dites-nous en quelques lignes ce dont vous avez besoin. Nous vous répondons sous 48 heures ouvrées.
        </p>
        <div class="btn-group cta-final-actions">
          <a href="/contact" class="btn-primary" data-magnetic data-glow>
            <span>Nous écrire</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* SECTION 1 — OUVERTURE PLEIN ÉCRAN */
  .opening-section {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 6.5rem;
    padding-bottom: var(--space-64);
    text-align: center;
  }

  .opening-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    max-width: 58rem;
    margin-inline: auto;
    gap: var(--space-24);
  }

  .opening-logo {
    margin-bottom: var(--space-8);
  }

  .opening-brand-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.9375rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .opening-title {
    font-size: clamp(2.5rem, 1.5rem + 4.5vw, 5.25rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
    max-width: 19ch;
    margin-inline: auto;
  }

  .opening-trilogy {
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    font-weight: 400;
    color: var(--text-muted);
    letter-spacing: -0.01em;
  }

  .opening-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-16);
    margin-top: var(--space-8);
  }

  /* Boutons en verre (.glass) */
  .btn-glass {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    padding: 0.95rem 1.75rem;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--fs-small);
    letter-spacing: 0.01em;
    color: var(--text);
    cursor: pointer;
    min-height: 3.125rem;
    transition: transform 250ms var(--ease-out), border-color 250ms var(--ease-out);
  }

  .btn-glass > * {
    position: relative;
    z-index: 1;
  }

  .btn-glass:hover .btn-arrow {
    transform: translateX(4px);
  }

  /* SECTION 2 — « NOTRE IDÉE » (PANNEAU QUI MONTE) */
  .idea-section {
    position: relative;
    z-index: 1;
    padding-block: var(--space-64);
  }

  @media (min-width: 1024px) {
    .idea-section {
      padding-block: var(--space-104);
    }
  }

  .idea-panel {
    border-radius: 28px;
    padding: clamp(2rem, 5vw, 4.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-40);
    overflow: hidden;
    transform-origin: center top;
  }

  .idea-panel > * {
    position: relative;
    z-index: 1;
  }

  .idea-header .eyebrow {
    margin-bottom: 0;
    justify-content: center;
  }

  .idea-stage {
    position: relative;
    width: 100%;
    max-width: 48rem;
    min-height: 17rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .idea-house-svg {
    width: 100%;
    height: auto;
    max-height: 16rem;
    overflow: visible;
  }

  .idea-nodes {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: center;
    justify-items: center;
    gap: var(--space-16);
    pointer-events: none;
  }

  .idea-node {
    padding: 0.9rem 1.25rem;
    border-radius: 18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    min-width: 9.5rem;
  }

  .idea-node > * {
    position: relative;
    z-index: 1;
  }

  .idea-node strong {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1rem;
    color: var(--text);
  }

  .idea-node span {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
  }

  .idea-node-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    margin-bottom: 0.15rem;
  }

  .idea-node--care .idea-node-dot {
    background-color: var(--tint-care);
    box-shadow: 0 0 12px var(--tint-care);
  }

  .idea-node--consulting .idea-node-dot {
    background-color: var(--tint-consulting);
    box-shadow: 0 0 12px var(--tint-consulting);
  }

  .idea-node--events .idea-node-dot {
    background-color: var(--tint-events);
    box-shadow: 0 0 12px var(--tint-events);
  }

  .idea-house-badge {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    padding: 1rem 1.6rem;
    border-radius: 999px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    box-shadow: var(--glass-shadow);
  }

  .idea-house-badge > * {
    position: relative;
    z-index: 1;
  }

  .idea-house-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .idea-house-sub {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  @media (max-width: 767px) {
    .idea-stage {
      min-height: auto;
      flex-direction: column;
      gap: var(--space-16);
    }
    .idea-house-svg {
      display: none;
    }
    .idea-nodes {
      position: static;
      grid-template-columns: 1fr;
      width: 100%;
    }
    .idea-house-badge {
      position: static;
      transform: none;
      margin-top: var(--space-8);
    }
  }

  .idea-video-slot {
    width: 100%;
    max-width: 56rem;
    border-radius: 20px;
    overflow: hidden;
  }

  .idea-video {
    width: 100%;
    display: block;
  }

  .idea-text {
    font-size: clamp(1.25rem, 1.05rem + 1.1vw, 1.85rem);
    font-weight: 500;
