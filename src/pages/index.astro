---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLogo, { type BrandKey } from '../components/BrandLogo.astro';
import {
  SHOW_TEAM,
  TEAM_MEMBERS,
  SHOW_HERO_VIDEO,
  HERO_VIDEO_URL,
} from '../config/flags';

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'SSE Solutions',
  alternateName: 'SSE Solutions — Social, Security and Events',
  url: 'https://ssesolutions.fr',
  email: ['cccare@ssesolutions.fr', 'ccconsulting@ssesolutions.fr'],
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'Essonne',
  },
};

interface SolutionCard {
  id: string;
  tintKey: 'care' | 'autonomie' | 'consulting' | 'events';
  transitionName: string;
  brand: BrandKey;
  name: string;
  href: string;
  pitch: string;
  tags: string[];
  problem: string;
  solution: string;
  audience: string;
  ctaLabel: string;
}

const solutions: SolutionCard[] = [
  {
    id: 'cc-care',
    tintKey: 'care',
    transitionName: 'solution-card-care',
    brand: 'cc-care',
    name: 'CC Care',
    href: '/cc-care',
    pitch:
      'Un accompagnement social sur-mesure pour vos bénéficiaires, résidents et équipes : permanence sociale, diagnostic et coordination d’accès aux droits pour éviter les ruptures de parcours.',
    tags: ['Permanence sociale', 'Accès aux droits', 'Sur site & à distance'],
    problem:
      'Des dossiers sociaux qui s’accumulent, des équipes débordées, des situations individuelles qui demandent du temps et un cadre clair.',
    solution:
      'Un accompagnement social sur site ou à distance, des ateliers collectifs et des écrits clairs pour vos équipes.',
    audience: 'Structures sociales et entreprises.',
    ctaLabel: 'Découvrir CC Care',
  },
  {
    id: 'autonomie-inclusion',
    tintKey: 'autonomie',
    transitionName: 'solution-card-autonomie',
    brand: 'cc-care',
    name: 'Autonomie & Inclusion',
    href: '/cc-care/autonomie-inclusion',
    pitch:
      'Le programme opérationnel de 35 modules et 244 ateliers pour développer l’autonomie quotidienne, le budget et le logement, en français courant et FALC.',
    tags: ['35 modules pratiques', '244 ateliers concrets', 'Français & FALC'],
    problem:
      'Des adultes accompagnés qui peinent avec les démarches, le budget, le logement ou le numérique, faute de supports adaptés.',
    solution:
      'Un programme en ligne de 35 modules et 244 ateliers, chacun en deux versions : français courant et FALC (Facile à lire et à comprendre).',
    audience:
      'Structures sociales, médico-sociales et d’insertion qui veulent équiper leurs équipes.',
    ctaLabel: 'Découvrir Autonomie & Inclusion',
  },
  {
    id: 'cc-consulting',
    tintKey: 'consulting',
    transitionName: 'solution-card-consulting',
    brand: 'cc-consulting',
    name: 'CC Consulting',
    href: '/cc-consulting',
    pitch:
      'Audit réglementaire, préparation rigoureuse aux commissions de sécurité, mise à jour des registres et schémas d’évacuation conformes aux exigences préfectorales.',
    tags: ['Conformité ERP', 'Commissions de sécurité', 'Levée de prescriptions'],
    problem:
      'Une commission de sécurité qui approche, un registre incomplet, des prescriptions difficiles à prioriser.',
    solution:
      'Un diagnostic sur site, un plan d’action priorisé et une présence à vos côtés avant, pendant et après la visite.',
    audience:
      'Directeurs et responsables sécurité d’établissements recevant du public (types J, U, O, R, W, M…).',
    ctaLabel: 'Découvrir CC Consulting',
  },
  {
    id: 'cc-events',
    tintKey: 'events',
    transitionName: 'solution-card-events',
    brand: 'cc-events',
    name: 'CC Events',
    href: '/cc-events',
    pitch:
      'Organisation clé en main de vos temps forts institutionnels et associatifs : rétroplanning minutieux, coordination des prestataires et pilotage terrain sans faille.',
    tags: ['Régie générale', 'Rétroplanning 360°', 'Présence terrain J-J'],
    problem:
      'Un événement à organiser sans équipe dédiée, des prestataires à coordonner, un jour J qui ne laisse pas droit à l’erreur.',
    solution:
      'Conception, rétroplanning, coordination des prestataires et présence sur le terrain du montage au démontage.',
    audience: 'Entreprises, institutions et associations qui organisent un événement.',
    ctaLabel: 'Découvrir CC Events',
  },
];
---

<BaseLayout
  title="SSE Solutions · Accompagnement social, sécurité incendie et événementiel en Essonne"
  description="Accompagnement social, sécurité incendie des ERP, événementiel : nous intervenons en Essonne auprès des établissements de santé et des entreprises."
  jsonLd={organizationJsonLd}
>
  <!-- SECTION 1 — OUVERTURE (PLEIN ÉCRAN) -->
  <section class="opening-section" data-particle-tint="care">
    <div class="container opening-inner">
      <div class="opening-logo" data-opening-item>
        <BrandLogo brand="sse-solutions" size="xl" loading="eager" alt="Logo SSE Solutions" />
      </div>

      <p class="opening-brand-name" data-opening-item>SSE Solutions</p>

      <h1 class="opening-title" data-opening-item>
        L’allié terrain pour vos équipes, vos établissements et vos événements.
      </h1>

      <p class="opening-trilogy" data-opening-item>Social. Sécurité. Événements.</p>

      <div class="opening-actions" data-opening-item>
        <a href="#solutions" class="btn-glass glass" data-magnetic data-glow>
          <span>Découvrir nos solutions</span>
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/contact" class="btn-glass btn-glass--secondary glass" data-glow>
          <span>Nous écrire</span>
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 2 — « NOTRE IDÉE » (BULLE LIQUIDE GLACE SIRI & ATTRACTEURS) -->
  <section class="idea-section" id="notre-idee" data-particle-tint="autonomie">
    <div class="container">
      <div class="idea-panel glass" data-idea-panel>
        <div class="idea-header">
          <p class="eyebrow">NOTRE IDÉE</p>
        </div>

        <!-- Scène Organique Siri : Bulle liquide centrale SSE Solutions et 3 bulles attirées -->
        <div
          class="siri-stage"
          data-siri-stage
          role="img"
          aria-label="Trois expertises — CC Care, CC Consulting et CC Events — attirées en gravitation au sein d'une seule maison : SSE Solutions"
        >
          <!-- Orbite d'attraction : les 3 bulles satellites Siri liquides sont attirées derrière SSE Solutions -->
          <div class="siri-bubble siri-bubble--satellite siri-bubble--care glass" data-siri-node="care">
            <div class="siri-bubble-sheen" aria-hidden="true"></div>
            <div class="siri-satellite-inner">
              <div class="siri-satellite-logo">
                <BrandLogo brand="cc-care" size="sm" loading="lazy" alt="Logo officiel CC Care" />
              </div>
              <strong class="siri-bubble-name">CC Care</strong>
              <span class="siri-bubble-role">Social</span>
            </div>
          </div>

          <div class="siri-bubble siri-bubble--satellite siri-bubble--consulting glass" data-siri-node="consulting">
            <div class="siri-bubble-sheen" aria-hidden="true"></div>
            <div class="siri-satellite-inner">
              <div class="siri-satellite-logo">
                <BrandLogo brand="cc-consulting" size="sm" loading="lazy" alt="Logo officiel CC Consulting" />
              </div>
              <strong class="siri-bubble-name">CC Consulting</strong>
              <span class="siri-bubble-role">Sécurité Incendie</span>
            </div>
          </div>

          <div class="siri-bubble siri-bubble--satellite siri-bubble--events glass" data-siri-node="events">
            <div class="siri-bubble-sheen" aria-hidden="true"></div>
            <div class="siri-satellite-inner">
              <div class="siri-satellite-logo">
                <BrandLogo brand="cc-events" size="sm" loading="lazy" alt="Logo officiel CC Events" />
              </div>
              <strong class="siri-bubble-name">CC Events</strong>
              <span class="siri-bubble-role">Événementiel</span>
            </div>
          </div>

          <!-- Bulle Centrale Principale : SSE Solutions (effet Siri liquide et verre spéculaire) -->
          <div class="siri-bubble siri-bubble--main glass" data-siri-core>
            <div class="siri-bubble-sheen" aria-hidden="true"></div>
            <div class="siri-bubble-content">
              <div class="siri-bubble-logo">
                <BrandLogo brand="sse-solutions" size="lg" loading="lazy" alt="Logo SSE Solutions" />
              </div>
              <h3 class="siri-bubble-title">SSE Solutions</h3>
              <span class="siri-bubble-badge">Une seule maison</span>
              <p class="siri-bubble-desc">
                Un interlocuteur unique pour coordonner le social, la sécurité et l'événementiel.
              </p>
            </div>
          </div>
        </div>

        {
          SHOW_HERO_VIDEO && HERO_VIDEO_URL && (
            <div class="idea-video-slot">
              <video
                src={HERO_VIDEO_URL}
                controls
                playsinline
                preload="metadata"
                class="idea-video"
              />
            </div>
          )
        }

        <p class="idea-text">
          SSE Solutions réunit trois activités qui partagent une même méthode : écouter, comprendre, agir et accompagner.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 3 — « NOS SOLUTIONS » (4 GRANDES CARTES QUI ARRIVENT L'UNE APRÈS L'AUTRE) -->
  <section class="solutions-section" id="solutions" data-solutions-pin>
    <div class="container solutions-container">
      <div class="solutions-header">
        <p class="eyebrow">NOS SOLUTIONS</p>
        <h2 class="section-title">Quatre réponses concrètes, selon votre besoin.</h2>
      </div>

      <div class="solutions-stack" data-solutions-stack>
        {
          solutions.map((item, index) => (
            <article
              class:list={['solution-card', `solution-card--${item.tintKey}`, 'glass']}
              data-solution-card
              data-solution-index={index}
              data-particle-tint={item.tintKey}
              transition:name={item.transitionName}
            >
              <a
                href={item.href}
                class="solution-card__link"
                aria-label={`${item.name} — ${item.ctaLabel}`}
              >
                <div class="solution-card__top">
                  <div class="solution-card__brand">
                    <BrandLogo brand={item.brand} size="md" loading="lazy" alt={`Logo ${item.name}`} />
                    <div class="solution-card__titles">
                      <span class="num-index">0{index + 1}</span>
                      <h3 class="solution-card__name">{item.name}</h3>
                    </div>
                  </div>

                  <span class="btn-glass solution-card__cta glass" data-magnetic>
                    <span>{item.ctaLabel}</span>
                    <span class="btn-arrow" aria-hidden="true">→</span>
                  </span>
                </div>

                <!-- Pitch Commercial avec Effet d'écriture rapide -->
                <div class="solution-card__commercial">
                  <div class="solution-typewriter" data-typewriter-text={item.pitch}>
                    <p class="solution-typewriter__text">{item.pitch}</p>
                    <span class="solution-typewriter__cursor" aria-hidden="true">|</span>
                  </div>

                  <div class="solution-tags">
                    {item.tags.map((tag) => (
                      <span class="solution-tag glass">{tag}</span>
                    ))}
                  </div>
                </div>

                <dl class="solution-card__grid">
                  <div class="solution-block">
                    <dt class="solution-block__label">Le problème</dt>
                    <dd class="solution-block__text">{item.problem}</dd>
                  </div>

                  <div class="solution-block">
                    <dt class="solution-block__label">Ce que nous apportons</dt>
                    <dd class="solution-block__text">{item.solution}</dd>
                  </div>

                  <div class="solution-block">
                    <dt class="solution-block__label">Pour qui</dt>
                    <dd class="solution-block__text">{item.audience}</dd>
                  </div>
                </dl>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SECTION 4 — « COMPRENDRE AVANT D'AGIR. » (MÉTHODE) -->
  <section class="section method-section" data-method-pin id="methode" data-particle-tint="consulting">
    <div class="container grid-12 method-grid">
      <div class="method-header">
        <p class="eyebrow" data-reveal>NOTRE MÉTHODE</p>
        <h2 class="section-title" data-reveal-title>
          <span class="reveal-mask">
            <span class="reveal-line">Écouter, comprendre, agir et accompagner.</span>
          </span>
        </h2>
      </div>

      <div class="method-timeline">
        <div class="method-rail" aria-hidden="true">
          <div class="method-rail-progress" data-method-progress></div>
        </div>

        <ol class="method-steps">
          <li class="method-step glass is-active">
            <span class="num-index">01</span>
            <div class="method-step-body">
              <h3 class="card-title">Écouter.</h3>
              <p class="prose-measure">
                Nous partons de votre situation, de vos contraintes et de vos échéances.
              </p>
            </div>
          </li>
          <li class="method-step glass">
            <span class="num-index">02</span>
            <div class="method-step-body">
              <h3 class="card-title">Diagnostiquer.</h3>
              <p class="prose-measure">
                Nous faisons un état des lieux précis et écrit.
              </p>
            </div>
          </li>
          <li class="method-step glass">
            <span class="num-index">03</span>
            <div class="method-step-body">
              <h3 class="card-title">Agir.</h3>
              <p class="prose-measure">
                Nous menons les actions avec vous et coordonnons les bons interlocuteurs.
              </p>
            </div>
          </li>
          <li class="method-step glass">
            <span class="num-index">04</span>
            <div class="method-step-body">
              <h3 class="card-title">Accompagner.</h3>
              <p class="prose-measure">
                Nous restons présents à vos côtés jusqu’au résultat, et dans la durée.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- SECTION 5 — « CE QUE VOUS POUVEZ ATTENDRE DE NOUS. » (ENGAGEMENTS) -->
  <section class="section section--spacious" id="engagements" data-particle-tint="events">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow" data-reveal>NOS ENGAGEMENTS</p>
        <h2 class="section-title" data-reveal-title>
          <span class="reveal-mask">
            <span class="reveal-line">Ce que vous pouvez attendre de nous.</span>
          </span>
        </h2>
      </div>

      <ol class="commitments-grid grid-12">
        <li class="commitment-card glass" data-glow data-reveal>
          <span class="num-index">01</span>
          <h3 class="card-title">Un interlocuteur.</h3>
          <p>Une personne qui connaît votre dossier, du premier échange au dernier.</p>
        </li>
        <li class="commitment-card glass" data-glow data-reveal>
          <span class="num-index">02</span>
          <h3 class="card-title">Des écrits clairs.</h3>
          <p>Des comptes rendus courts, datés et compréhensibles par tous.</p>
        </li>
        <li class="commitment-card glass" data-glow data-reveal>
          <span class="num-index">03</span>
          <h3 class="card-title">Le terrain.</h3>
          <p>Des solutions pensées pour votre établissement, pas pour un modèle type.</p>
        </li>
        <li class="commitment-card glass" data-glow data-reveal>
          <span class="num-index">04</span>
          <h3 class="card-title">La discrétion.</h3>
          <p>Les situations sociales et les informations de sécurité restent confidentielles.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- SECTION 6 — « QUI EST DERRIÈRE SSE SOLUTIONS » (MASQUÉ PAR SHOW_TEAM=false) -->
  {
    SHOW_TEAM && TEAM_MEMBERS.length > 0 && (
      <section class="section section--spacious" id="equipe">
        <div class="container">
          <div class="section-header">
            <p class="eyebrow" data-reveal>ÉQUIPE</p>
            <h2 class="section-title" data-reveal-title>
              <span class="reveal-mask">
                <span class="reveal-line">Qui est derrière SSE Solutions</span>
              </span>
            </h2>
          </div>

          <ul class="team-grid grid-12">
            {TEAM_MEMBERS.map((member) => (
              <li class="team-card glass" data-glow data-reveal>
                {member.photo && (
                  <div class="team-photo media-frame">
                    <img
                      src={member.photo}
                      alt={member.name}
                      width="480"
                      height="480"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}
                <div class="team-body">
                  <h3 class="card-title">{member.name}</h3>
                  <p class="team-role">{member.role}</p>
                  <p class="team-meta">{member.diploma}</p>
                  <p class="team-meta">{member.experienceYears}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- SECTION 7 — « PARLONS DE VOTRE PROJET. » (CONTACT, EN .GLASS) -->
  <section class="section section--spacious cta-final" data-particle-tint="care">
    <div class="container">
      <div class="cta-final-card glass glass--refract" data-glow data-reveal>
        <h2 class="section-title" data-reveal-title>
          <span class="reveal-mask">
            <span class="reveal-line">Parlons de votre projet.</span>
          </span>
        </h2>
        <p class="prose-measure cta-final-text">
          Dites-nous en quelques lignes ce dont vous avez besoin. Nous vous répondons sous 48 heures ouvrées.
        </p>
        <div class="btn-group cta-final-actions">
          <a href="/contact" class="btn-primary" data-magnetic data-glow>
            <span>Nous écrire</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* SECTION 1 — OUVERTURE PLEIN ÉCRAN */
  .opening-section {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 6.5rem;
    padding-bottom: var(--space-64);
    text-align: center;
  }

  .opening-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    max-width: 58rem;
    margin-inline: auto;
    gap: var(--space-24);
  }

  .opening-logo {
    margin-bottom: var(--space-8);
  }

  .opening-brand-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.9375rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .opening-title {
    font-size: clamp(2.5rem, 1.5rem + 4.5vw, 5.25rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
    max-width: 19ch;
    margin-inline: auto;
  }

  .opening-trilogy {
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    font-weight: 400;
    color: var(--text-muted);
    letter-spacing: -0.01em;
  }

  .opening-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-16);
    margin-top: var(--space-8);
  }

  /* Boutons en verre (.glass) */
  .btn-glass {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    padding: 0.95rem 1.75rem;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: var(--fs-small);
    letter-spacing: 0.01em;
    color: var(--text);
    cursor: pointer;
    min-height: 3.125rem;
    transition: transform 250ms var(--ease-out), border-color 250ms var(--ease-out);
  }

  .btn-glass > * {
    position: relative;
    z-index: 1;
  }

  .btn-glass:hover .btn-arrow {
    transform: translateX(4px);
  }

  /* SECTION 2 — « NOTRE IDÉE » (PANNEAU QUI MONTE) */
  .idea-section {
    position: relative;
    z-index: 1;
    padding-block: var(--space-64);
  }

  @media (min-width: 1024px) {
    .idea-section {
      padding-block: var(--space-104);
    }
  }

  .idea-panel {
    border-radius: 28px;
    padding: clamp(2rem, 5vw, 4.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-40);
    overflow: hidden;
    transform-origin: center top;
  }

  .idea-panel > * {
    position: relative;
    z-index: 1;
  }

  .idea-header .eyebrow {
    margin-bottom: 0;
    justify-content: center;
  }

  .idea-stage {
    position: relative;
    width: 100%;
    max-width: 52rem;
    min-height: 25rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .siri-stage {
    position: relative;
    width: 100%;
    max-width: 62rem;
    min-height: clamp(42rem, 64vh, 48rem);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-inline: auto;
  }

  /* Bulle Centrale Siri : forme sphérique liquide fluide à 120 FPS sur GPU */
  @keyframes siriLiquidBlob {
    0%, 100% {
      transform: translate(-50%, -50%) scale(1) rotate(0deg);
    }
    33% {
      transform: translate(-50%, -50%) scale(1.02) rotate(1.5deg);
    }
    66% {
      transform: translate(-50%, -50%) scale(0.985) rotate(-1.5deg);
    }
  }

  .siri-bubble--main {
    position: absolute;
    left: 50%;
    top: 62%;
    transform: translate(-50%, -50%);
    width: clamp(16.5rem, 28vw, 20.5rem);
    height: clamp(16.5rem, 28vw, 20.5rem);
    border-radius: 50%;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    animation: siriLiquidBlob 8.5s ease-in-out infinite;
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    backdrop-filter: blur(14px) saturate(160%);
    border: 1.5px solid rgba(255, 255, 255, 0.55);
    box-shadow:
      0 0 35px -5px rgba(79, 209, 165, 0.35),
      0 0 55px -10px rgba(169, 155, 255, 0.3),
      0 18px 40px rgba(0, 0, 0, 0.3),
      inset 0 0 25px rgba(255, 255, 255, 0.2),
      inset 0 2px 4px rgba(255, 255, 255, 0.5);
    will-change: transform;
  }

  html[data-theme="light"] .siri-bubble--main {
    border-color: rgba(255, 255, 255, 0.9);
    box-shadow:
      0 0 30px -5px rgba(11, 122, 90, 0.2),
      0 0 50px -10px rgba(91, 75, 196, 0.16),
