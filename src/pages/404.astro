---
import BaseLayout from '../layouts/BaseLayout.astro';
import LivingMesh from '../components/LivingMesh.astro';
---

<BaseLayout
  title="Cette page n'existe pas — SSE Solutions"
  description="Cette page n'existe pas. Retournez à l'accueil de SSE Solutions ou contactez-nous."
>
  <section class="section error-404">
    <LivingMesh />
    <div class="container grid-12">
      <div class="error-404-content">
        <p class="eyebrow">ERREUR 404</p>
        <h1 class="hero-title">Cette page n'existe pas.</h1>
        <p class="prose-measure error-404-lead">
          Le lien que vous avez suivi est peut-être ancien ou incomplet. Vous pouvez revenir à l'accueil ou nous écrire directement.
        </p>
        <div class="btn-group">
          <a href="/" class="btn-primary" data-magnetic data-glow>
            <span>Retour à l'accueil</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
          <a href="/contact" class="btn-secondary glass" data-glow>
            <span>Nous écrire</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-404 {
    position: relative;
    min-height: 78vh;
    display: flex;
    align-items: center;
    padding-top: 8.5rem;
    padding-bottom: var(--space-104);
    overflow: hidden;
    isolation: isolate;
  }

  .error-404-content {
    grid-column: 1 / -1;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 960px) {
    .error-404-content {
      grid-column: 1 / 9;
    }
  }

  .error-404-lead {
    margin-top: var(--space-24);
    margin-bottom: var(--space-40);
    color: var(--text);
  }
</style>
