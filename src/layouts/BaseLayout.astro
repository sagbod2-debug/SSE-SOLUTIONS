---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LivingMesh from '../components/LivingMesh.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  theme?: 'default' | 'cc-care' | 'autonomie-inclusion' | 'cc-consulting' | 'cc-events';
  canonicalPath?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
  /** Fond de particules commun ; une page peut le remplacer par son propre fond animé. */
  livingMesh?: boolean;
}

const {
  title,
  description,
  theme = 'default',
  canonicalPath = Astro.url.pathname,
  ogImage,
  jsonLd,
  livingMesh = true,
} = Astro.props;

const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://ssesolutions.fr';
const cleanPath = canonicalPath === '/' ? '/' : canonicalPath.replace(/\/$/, '');
const canonicalUrl = `${siteOrigin}${cleanPath}`;

const cleanTitle = title.replace(/'/g, '’');
const cleanDescription = description.replace(/'/g, '’');

const slugForOg =
  cleanPath === '/'
    ? 'index'
    : cleanPath.replace(/^\//, '').replace(/\//g, '-');
const ogImageUrl = ogImage || `${siteOrigin}/og/${slugForOg}.png`;
---

<!doctype html>
<html
  lang="fr"
  data-theme="light"
  data-activity={theme === 'default' ? undefined : theme}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{cleanTitle}</title>
    <meta name="description" content={cleanDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- 3.1 Favicon & Manifest -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Préchargement de la police auto-hébergée (Google Sans Flex, variable) -->
    <link
      rel="preload"
      href="/fonts/google-sans-flex-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- 3.1 Open Graph & Twitter / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="SSE Solutions" />
    <meta property="og:title" content={cleanTitle} />
    <meta property="og:description" content={cleanDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={cleanTitle} />
    <meta name="twitter:description" content={cleanDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" id="meta-theme-color" content="#FFFFFF" />

    <!-- Thème clair / sombre : choix mémorisé, sinon préférence du système -->
    <script is:inline>
      (function () {
        function pick() {
          var t = null;
          try { t = localStorage.getItem('sse-theme'); } catch (e) {}
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          return t;
        }
        function apply(root) {
          var t = pick();
          root.setAttribute('data-theme', t);
          var m = (root.ownerDocument || document).getElementById('meta-theme-color');
          if (m) m.setAttribute('content', t === 'dark' ? '#0E0F11' : '#FFFFFF');
        }
        apply(document.documentElement);
        document.addEventListener('astro:before-swap', function (ev) {
          if (ev && ev.newDocument) apply(ev.newDocument.documentElement);
        });
      })();
    </script>

    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }

    <ClientRouter />
  </head>
  <body>
    <!-- 7.3 Réfraction optique sur Chromium -->
    <svg class="liquid-glass-svg-defs" width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute;width:0;height:0;overflow:hidden;pointer-events:none;">
      <filter id="liquid-glass">
        <feTurbulence type="fractalNoise" baseFrequency="0.015" numOctaves="2" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="18" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <a href="#main-content" class="skip-link">Aller au contenu</a>

    <!-- Arrière-plan vivant de particules WebGL sur l'ensemble du site -->
    {livingMesh && <LivingMesh fixed={true} />}

    <Header />

    <main id="main-content" tabindex="-1" transition:animate="fade">
      <slot />
    </main>

    <Footer />

    <script src="../scripts/site.ts"></script>
  </body>
</html>
