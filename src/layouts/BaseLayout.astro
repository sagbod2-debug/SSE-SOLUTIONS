---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  theme?: 'default' | 'cc-care' | 'cc-consulting' | 'cc-events';
  canonicalPath?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  theme = 'default',
  canonicalPath = Astro.url.pathname,
  ogImage,
  jsonLd,
} = Astro.props;

const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://ssesolutions.fr';
const cleanPath = canonicalPath === '/' ? '/' : canonicalPath.replace(/\/$/, '');
const canonicalUrl = `${siteOrigin}${cleanPath}`;

const cleanTitle = title.replace(/'/g, '’');
const cleanDescription = description.replace(/'/g, '’');

const slugForOg =
  cleanPath === '/'
    ? 'index'
    : cleanPath.replace(/^\//, '').replace(/\//g, '-');
const ogImageUrl = ogImage || `${siteOrigin}/og/${slugForOg}.png`;
---

<!doctype html>
<html
  lang="fr"
  data-theme="dark"
  data-activity={theme === 'default' ? undefined : theme}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{cleanTitle}</title>
    <meta name="description" content={cleanDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- 3.1 Favicon & Manifest -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Préchargement des polices auto-hébergées -->
    <link
      rel="preload"
      href="/fonts/marcellus-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/hanken-grotesk-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/hanken-grotesk-600-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- 3.1 Open Graph & Twitter / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="SSE Solutions" />
    <meta property="og:title" content={cleanTitle} />
    <meta property="og:description" content={cleanDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={cleanTitle} />
    <meta name="twitter:description" content={cleanDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" id="meta-theme-color" content="#111416" />

    <!-- 1.3 Script en ligne anti-flash de thème + persistance View Transitions -->
    <script is:inline>
      (function () {
        var STORAGE_KEY = 'sse-theme';
        function getPref() {
          try {
            var v = localStorage.getItem(STORAGE_KEY);
            if (v === 'light' || v === 'dark' || v === 'system') return v;
          } catch (e) {}
          return 'system';
        }
        function resolveTheme(pref) {
          if (pref === 'light' || pref === 'dark') return pref;
          return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
        }
        function applyTheme(doc, pref) {
          var resolved = resolveTheme(pref);
          var root = doc.documentElement;
          root.setAttribute('data-theme', resolved);
          root.setAttribute('data-theme-pref', pref);
          var meta = doc.getElementById('meta-theme-color');
          if (meta) {
            meta.setAttribute('content', resolved === 'light' ? '#FFFFFF' : '#0A0B0F');
          }
        }
        applyTheme(document, getPref());
        document.addEventListener('astro:before-swap', function (ev) {
          if (ev && ev.newDocument) {
            applyTheme(ev.newDocument, getPref());
          }
        });
        document.addEventListener('astro:after-swap', function () {
          applyTheme(document, getPref());
        });
        if (window.matchMedia) {
          window
            .matchMedia('(prefers-color-scheme: dark)')
            .addEventListener('change', function () {
              if (getPref() === 'system') applyTheme(document, 'system');
            });
        }
      })();
    </script>

    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }

    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Aller au contenu</a>

    <Header />

    <main id="main-content" tabindex="-1" transition:animate="fade">
      <slot />
    </main>

    <Footer />

    <script src="../scripts/site.ts"></script>
  </body>
</html>
