{
  "$schema": "https://tr.designtokens.org/format/",
  "meta": {
    "name": "SSE Solutions — Design DNA Tokens (Lot 7)",
    "version": "3.0.0",
    "description": "Jetons de design Lot 7 : fond blanc pur (#FFFFFF) en clair, noir profond (#0A0B0F) en sombre, Hanken Grotesk unifié, Liquid Glass prononcé et teintes d'activité (vert, bleu-vert, rouge, violet)."
  },
  "color": {
    "theme": {
      "light": {
        "bg": { "$value": "#FFFFFF", "$type": "color" },
        "surface": { "$value": "#FFFFFF", "$type": "color" },
        "text": { "$value": "#0B0D12", "$type": "color", "contrastOnBg": "19.4:1" },
        "text-muted": { "$value": "#5B6270", "$type": "color", "contrastOnBg": "6.1:1" },
        "line": { "$value": "rgba(11, 13, 18, 0.08)", "$type": "color" },
        "button-primary-bg": { "$value": "#0B0D12", "$type": "color" },
        "button-primary-text": { "$value": "#FFFFFF", "$type": "color", "contrastOnBg": "19.4:1" }
      },
      "dark": {
        "bg": { "$value": "#0A0B0F", "$type": "color" },
        "surface": { "$value": "#14161C", "$type": "color" },
        "text": { "$value": "#F4F6FA", "$type": "color", "contrastOnBg": "18.2:1" },
        "text-muted": { "$value": "#A1A8B5", "$type": "color", "contrastOnBg": "8.2:1" },
        "line": { "$value": "rgba(255, 255, 255, 0.10)", "$type": "color" },
        "button-primary-bg": { "$value": "#FFFFFF", "$type": "color" },
        "button-primary-text": { "$value": "#0B0D12", "$type": "color", "contrastOnBg": "19.4:1" }
      }
    },
    "activityTint": {
      "cc-care": {
        "light": { "$value": "#0B7A5A", "$type": "color", "contrast": "5.3:1" },
        "dark": { "$value": "#4FD1A5", "$type": "color", "contrast": "10.3:1" }
      },
      "autonomie-inclusion": {
        "light": { "$value": "#0A7A88", "$type": "color", "contrast": "5.1:1" },
        "dark": { "$value": "#4FD6E8", "$type": "color", "contrast": "11.4:1" }
      },
      "cc-consulting": {
        "light": { "$value": "#D42A3A", "$type": "color", "contrast": "5.0:1" },
        "dark": { "$value": "#FF6B75", "$type": "color", "contrast": "7.1:1" }
      },
      "cc-events": {
        "light": { "$value": "#5B4BC4", "$type": "color", "contrast": "6.5:1" },
        "dark": { "$value": "#A99BFF", "$type": "color", "contrast": "8.3:1" }
      }
    }
  },
  "material": {
    "glass": {
      "blur": "24px",
      "saturate": "180%",
      "brightness": "1.04",
      "pointerGlowRadius": "280px",
      "light": {
        "background": "rgba(255, 255, 255, 0.42)",
        "border": "rgba(255, 255, 255, 0.75)",
        "outerRing": "0 0 0 1px rgba(11, 13, 18, 0.06)",
        "shadow": "0 12px 40px rgba(11, 13, 18, 0.10)",
        "pointerGlow": "rgba(255, 255, 255, 0.35)"
      },
      "dark": {
        "background": "rgba(255, 255, 255, 0.06)",
        "border": "rgba(255, 255, 255, 0.16)",
        "shadow": "0 12px 40px rgba(0, 0, 0, 0.45)",
        "pointerGlow": "rgba(255, 255, 255, 0.12)"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "display": { "$value": ["Hanken Grotesk", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif"], "$type": "fontFamily" },
      "sans": { "$value": ["Hanken Grotesk", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif"], "$type": "fontFamily" }
    },
    "fontWeight": {
      "heading": 500,
      "body": 400,
      "eyebrow": 600
    },
    "fontSize": {
      "fs-display": { "$value": "clamp(2.75rem, 1.6rem + 5vw, 5.75rem)", "$type": "dimension" },
      "fs-h2": { "$value": "clamp(2rem, 1.4rem + 2.6vw, 3.5rem)", "$type": "dimension" },
      "fs-h3": { "$value": "clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem)", "$type": "dimension" },
      "fs-body": { "$value": "clamp(1rem, 0.96rem + 0.2vw, 1.125rem)", "$type": "dimension" },
      "fs-small": { "$value": "0.875rem", "$type": "dimension" },
      "fs-eyebrow": { "$value": "0.75rem", "$type": "dimension" }
    },
    "lineHeight": {
      "heading": 1.05,
      "body": 1.6
    },
    "letterSpacing": {
      "h1": "-0.03em",
      "h2": "-0.02em",
      "eyebrow": "0.14em"
    },
    "measure": {
      "paragraphMax": "68ch"
    }
  },
  "spacing": {
    "space-8": { "$value": "0.5rem", "px": 8, "$type": "dimension" },
    "space-16": { "$value": "1rem", "px": 16, "$type": "dimension" },
    "space-24": { "$value": "1.5rem", "px": 24, "$type": "dimension" },
    "space-40": { "$value": "2.5rem", "px": 40, "$type": "dimension" },
    "space-64": { "$value": "4rem", "px": 64, "$type": "dimension" },
    "space-104": { "$value": "6.5rem", "px": 104, "$type": "dimension" },
    "space-168": { "$value": "10.5rem", "px": 168, "$type": "dimension" }
  },
  "motion": {
    "easing": {
      "ease-out": { "$value": "cubic-bezier(0.22, 1, 0.36, 1)", "$type": "cubicBezier" },
      "ease-spring": { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "cubicBezier" }
    },
    "duration": {
      "clickActive": "120ms",
      "cascadeStagger": "120ms",
      "linkUnderline": "300ms",
      "themeTransition": "400ms",
      "imageFadeIn": "400ms",
      "magneticReturn": "400ms",
      "viewTransitionMorph": "600ms",
      "cardImageScale": "700ms",
      "counterScroll": "1200ms"
    }
  }
}
